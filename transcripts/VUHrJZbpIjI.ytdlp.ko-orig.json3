{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  }, {
    "mhModeHint": 0,
    "juJustifCode": 0,
    "sdScrollDir": 3
  } ],
  "wpWinPositions": [ {
  
  }, {
    "apPoint": 6,
    "ahHorPos": 20,
    "avVerPos": 100,
    "rcRows": 2,
    "ccCols": 40
  }, {
    "apPoint": 7,
    "ahHorPos": 50,
    "avVerPos": 100,
    "rcRows": 2,
    "ccCols": 40
  } ],
  "events": [ {
    "tStartMs": 0,
    "id": 1,
    "wpWinPosId": 2,
    "wsWinStyleId": 1
  }, {
    "tStartMs": 1560,
    "dDurationMs": 12680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "피곤한데 왜 잠들지 못할까?\n진짜 너무 피곤한데 말동말동 잠이 안",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 9240,
    "dDurationMs": 11400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "올까? 어 불면의 고통은\n다 겪어 보신음",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 17000,
    "dDurationMs": 11039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "경험이 있을 거라고 생각을 합니다.\n그런데이 질문 자체가 잘못된 겁니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 23760,
    "dDurationMs": 10240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "왜 잠이 안 올까? 이런 거예요.\n잠이 어디선가 와야 되는 것 또는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 30080,
    "dDurationMs": 9799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "모자란 것 채워야 하는 걸로 보죠.\n그래서 모자한 잠을 채우기 위해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 36160,
    "dDurationMs": 9879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "노력을 하죠. 이게 다 잘못된 고정\n관념이고 이게 다 우리의 수면을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 43399,
    "dDurationMs": 9721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "방해합니다. 그래서 우리는 뭘\n먹어서라도 잠 늘리려고 하고 어 너무",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 50160,
    "dDurationMs": 8079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠을 못 자 일찍 눕고\n또 더 오래 누워 있으려고 하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 55800,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하죠. 아 김정환 교수가 수면 시간\n확보했어. 일찍 들어가고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 61000,
    "dDurationMs": 10479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "늦게까지 누워 있고\n도움이 안 됩니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 65920,
    "dDurationMs": 13160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지난 수십년 간의 수면 의학의 결론은\n만성적으로 잠자는데 어려움을 겪으시는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 76080,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "분들은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 79560,
    "dDurationMs": 9239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뇌와 몸이\n잠을 만들어내는 힘이 약한게 아니라",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 84360,
    "dDurationMs": 11320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "즉 잠을 잠에 드는 어떤 그 능력이\n약해진게 아니라 깨어 있음, 각성을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 93520,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "끄는게 게 안되는 상태입니다. 이건\n상당히 다른 얘기입니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 98119,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서이\n우리가 불면증이다 또는 어떤 수면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 102479,
    "dDurationMs": 11521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "장애를 어 겪는다 하는 거는 하이퍼\n과도한 어우 각성 때문입니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 111920,
    "dDurationMs": 7960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지금 그 생각해 보면 어 그렇지\n각성이 많이 돼서 과도한 각성 좀",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 116320,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "당연하다고 느끼실지 모르지만이 개념이\n딱 자리 잡은 건 2000년대",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 122360,
    "dDurationMs": 7879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "들어와서 2010년 정도 이후\n얘기입니다. [목을 가다듬음]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 127320,
    "dDurationMs": 6301,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 우리는 질문을 바꿔야 됩니다.\n왜 잠이 안 오는가? 이건 답이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 131800,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "없어요. 그거에 대한 왜냐면\n[목을 가다듬음] 잠은 내가 만들어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 135319,
    "dDurationMs": 10681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "낼 수가 없어요.\n잠은 우리가 do잉 하는게 아니에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 141840,
    "dDurationMs": 10399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "두잉이 멈추고 잠에 들어가는 거죠.\n이렇게 질문을 바꿔야 돼요. 왜 각성",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 148599,
    "dDurationMs": 9521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "상태가 즉 깨어 있는 상태가 스톱되지\n않는가? 왜 깨어 있음이 꺼지지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 155680,
    "dDurationMs": 8320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "않는가? 그 왜 그렇게 질문을 바꿔야\n되냐면 각성 상태는 내가 만들어내는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 161400,
    "dDurationMs": 9479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "것이기 때문에 그래요. 그래서 각성\n상태는 내가 껐다 켰다 할 수",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 167040,
    "dDurationMs": 11600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있어요. 그래서 우리는 잠을 자려고\n노력을 하는게 아니라 각성을 스톱,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 175239,
    "dDurationMs": 10601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내가 컨트롤할 수 있는 거잖아요.\n그래서 각성 상태를 그만두는 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 182200,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "방향으로 어 이제 그 집중을 해야\n되는 거죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 188799,
    "dDurationMs": 9681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "인소니아 디스워드 불면 장애이 뭐\n불면증 또는이 수면 장애 뭐 불면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 193959,
    "dDurationMs": 11601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "장애 이거는 어 불안 장애의 대표적인\n형태입니다. 그리고이 자물 설치는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 201920,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거는 정신 건강이\n악화됐음을 나타내는 대표적인",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 208280,
    "dDurationMs": 9159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "징표입니다.\n즉 거의 모든 정신 질환이 뭐",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 214599,
    "dDurationMs": 11161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "우울증이든 불안장애든 모든 공황이든\n뭐 뭐 바이폴라디소든 모든 거의 모든",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 222959,
    "dDurationMs": 8761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "정신 질환이 수면 장애를\n동반합니다.이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 228319,
    "dDurationMs": 11161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "굉장히 아주 고통스러운 문제죠. 많은\n분들이 점점 더 많은 분들이 어 여러",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 235599,
    "dDurationMs": 9360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가지 형태 불면증 수면 장애로 고생을\n하십니다. 불면증은 이제 입면 장애도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 243319,
    "dDurationMs": 5961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "문제고 잠에 드는 거 그게\n어려워하시는 분도 있고 또 잠을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 247599,
    "dDurationMs": 8241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지속적으로\n한 7시간 이상 지속적으로 쭉 통",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 252480,
    "dDurationMs": 9319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "주무시는 거 그게 어려워서 막 두어\n시간마다 자꾸 깨고 심한 경우 한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 258040,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시간마다도 깨요. 너무 고통스럽죠.\n그리고 뭐 한 세시간 네시간 자고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 264120,
    "dDurationMs": 9600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "깨서 더 자고 싶은데 피곤한데 잠이\n안 들고 이런 거예요. 그런게 다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 270240,
    "dDurationMs": 11840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "다양한 형태 수면 장애입니다. 그래서\n그것에 대해서도 연구가 많이 돼",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 276160,
    "dDurationMs": 12360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "왔는데 가장 중 중대한 전화는 질문의\n방향을 역전시켜 방향을 바꿔 놓는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 285800,
    "dDurationMs": 9239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요. 각성으로 지금 각성에 대한\n문제로 어 바꿔 놓는 거죠. 수면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 292120,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "곤란을 겪는 대다수의 환자는 밤마다\n침대 누워 왜 잠이 안 오지?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 297759,
    "dDurationMs": 10081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내 내내 뇌에 잠드는 기능 수면 생성\n기능에 뭐 문제가 생겼나? 어떻하면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 304720,
    "dDurationMs": 9800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면 생성 기능을 올리지? 이런\n식으로 생각을 하는 거죠. 즉 수면을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 311400,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내가 능동적으로 생성해야 될 물질의\n분비나 그러니까 그 물질이 없나?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 317240,
    "dDurationMs": 9239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그럼 뭘 먹어야 되나? 이런 생각하고\n또는 어떤 자유적 상태로 그래서 뭐가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 322400,
    "dDurationMs": 9720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어떻게 해야 이게 수면에 드는 상태로\n그래서 입면 실패 원인을 잠드는 거의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 329080,
    "dDurationMs": 8959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "실패 원인을 수면 생성 시스템의\n부제라든지에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 334520,
    "dDurationMs": 10320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면 생성 시스템의 고장\n그걸로 찾으려 하는데 그게 오해구",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 341160,
    "dDurationMs": 3680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "오류라는 얘기예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 344880,
    "dDurationMs": 10480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "안성 불면 장애 환자의 이제 연구\n결과 보면은 뇌일주기 리듬 프로세스",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 351919,
    "dDurationMs": 9720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "C라고 합니다. 또는 수면 항상성\n압력 호메어스테틱 슬립 드라이버 또는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 359400,
    "dDurationMs": 8440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "슬립 프레셔ure라고 하고 또는\n프로세스 S라고 합니다. 그 프로세스",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 364280,
    "dDurationMs": 10319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "C랑 프로세스 S를 관장하는 수면\n촉진 회로 자체는 그냥 잘 있어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 372039,
    "dDurationMs": 10401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "큰 문제가 없다고요.\n그런데도 불면증이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 376800,
    "dDurationMs": 12440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러니까 잠 자는 거의 문제가 본질이\n아닌 거예요. 각성이 각성 상태에서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 386199,
    "dDurationMs": 8921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "벗어나지 못하는 것 이런 거예요.\n생존 위협과 감시를 위해서 wake",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 393240,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "around 그러니까 이거 위협을\n느끼고 이래서 각성된 거 그게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 397680,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "작동하지 않는 거예요. 그러니까\n수면에 못 들어가는게 문제가 아니라",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 402800,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "각성 엔진 브레이크가 작동하지 않는\n거예요. 한마디로 수면의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 406800,
    "dDurationMs": 10399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "실패라기보다는 [목을 가다듬음]\nfailure of the의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 412800,
    "dDurationMs": 8880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "꺼짐 탈각성에 실패한 거죠. 그래서\n여기에 포커스를 맞춰야 됩니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 420039,
    "dDurationMs": 4681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그럼 어떻게 각성 상태에서 내가\n어떻게 벗어날 것인가? 여기에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 423120,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "포커스를 맞춰야 돼. 어떻게 내가\n잠이 들 것인가가 아니라",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 428080,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증을 해결하기 위한 과학적인\n질문은 올바른 질문은요. 왜 잠이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 433240,
    "dDurationMs": 8679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "오지 않는가? 그거가 아니에요.\n질문을 이렇게 던지세요. 왜 나는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 437960,
    "dDurationMs": 9959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내이 웨이ful니스이 각성 이게\n꺼지지 않지? 왜 자꾸 이렇게 각성돼",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 445039,
    "dDurationMs": 9361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있지? 요걸로 질문을 바꾸셔야\n됩니다. 그리고 아까요 위에서 지금",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 451319,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "말씀하 말씀드린 프로세스 C 프로세스\nS라는 건 뭐냐면 잠자는데 있어서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 457759,
    "dDurationMs": 6921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠자는데 있어서이 뇌에서 어 두 가지\n프로세스가 돌아갑니다. 별도의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 463160,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "프로세스예요.\n서케디언 리듬이라는 건 뭐냐면 그건",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 467520,
    "dDurationMs": 8079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이제 빛의 영향을 많이 받습니다.\n우리 뇌 이거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 473039,
    "dDurationMs": 7681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시신경의 일종인데 사물을 보는 건\n아니고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 477120,
    "dDurationMs": 8639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "빛에 반응하는 아 그런 그게 있어요.\n그래 가지고 그 빛에 반응을 해서이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 483759,
    "dDurationMs": 9321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지구가 어떻게 도는지 24시간 어떻게\n도는지 그 서퀘리언 리듬을 어이 몸이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 489680,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "예 그거에 따라 좀 움직입니다.\n그래서 그 일주기 리듬에 따라서이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 496440,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "멜라토닌이 나오고 뭐 이런 얘기도\n들으셨죠. 네. 그런 거죠. 그다음에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 502479,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "슬립 프레셔라는 것 또는이 슬립\n드라이브 이거는 수면 항상성이라는 건",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 508360,
    "dDurationMs": 7919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐냐하면\n잠에서 딱 깨면은 잠에서 깨자마자는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 513719,
    "dDurationMs": 5841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "코르티솔 레벨이 쫙 올라가고 그래서\n아침에는이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 517800,
    "dDurationMs": 7560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "각성 상태가 됩니다. 그러니까 잠을\n깨는 거죠. 그리고 아침에 각성",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 522360,
    "dDurationMs": 9800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "상태가 된 다음부터는 점점 점점\n시간이 지나감에 따라 코르티솔 레벨도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 528800,
    "dDurationMs": 10719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "점점 내려가고 또 아데노신도 점점\n점점 쌓입니다. 그래서 아데노신이라는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 535240,
    "dDurationMs": 10200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "물질이 많이 쌓여서 그게 꽉 말하면\n수면 압력을 주는 거예요. 슬립",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 541760,
    "dDurationMs": 8840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "프레셔라고. 한마디로 아데노신이 점점\n점점 점점 쌓여 가지고 저녁 때 더",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 548399,
    "dDurationMs": 7041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "쌓이고 밤 되면 더 쌓여. 그래서\n그게 너무 많이 쌓였어. 그러면 아우",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 552480,
    "dDurationMs": 9640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "졸려. 그리고 자는 거예요. 그러니까\n이게 이건 호르몬 쪽의 문제죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 558959,
    "dDurationMs": 9560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "우리가 커피를 마시잖아요. 그러면\n커피 그 카페인은 바로이 아데노신",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 565600,
    "dDurationMs": 6120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수용체에 작용을 합니다. 그래서\n아데노신이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 570120,
    "dDurationMs": 6719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "쌓여도\n졸름을 못 느끼게 우리 신경 시스템을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 575320,
    "dDurationMs": 5320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "말하자면이\n그 에러를 만들어내는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 579000,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아데노신이 있는데 그건 피곤함을\n느끼고 졸 졸림을 느껴야 되는데 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 584360,
    "dDurationMs": 7800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아데노신이 있으면 그거 수용체 걔가\n수용체에 딱게 아데노신이 달라붙어야지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 590079,
    "dDurationMs": 6961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 아데노신이 작동할 거 아니에요.\n근데 카페인이 거기에 달라붙는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 593920,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요. 그래서 아데노신의 압력을 못\n느껴요. 그러니까 어떻게 돼요?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 598800,
    "dDurationMs": 9240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "실제로 신체는 피곤한데\n안 피곤한 것처럼 느끼는 거죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 605320,
    "dDurationMs": 6320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아데노신 레벨이 굉장히 낮은 거라고이\n착각을 하게 되는 거죠. 우리 몸이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 609959,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그게 카페인인 겁니다. 그 그래서\n커피 마시고 하는 그런 거죠. 자",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 614560,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러면은\n일주기 리듬 수면 항상사 이거는 다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 619320,
    "dDurationMs": 7079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "제대로 돌아가는데 한마디로 아데노신도\n막 쌓이고 말이에요. 일주기 리듬에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 624040,
    "dDurationMs": 7799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "따라서이 신체도 왔다 갔다 뭐\n멜라토니도 나오고 하는데 그래도 잠에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 629360,
    "dDurationMs": 9560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "못 드는 거 그게 불면증인 거예요.이\n잠드는 시스템이 고장난게 아니라 각성",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 635360,
    "dDurationMs": 7960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "상태에서 빠져나오지 못하는 거 그게\n어이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 640920,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "문제다 하는 겁니다. 그럼 뭔 이제\n각성이 뭔지 알아야겠죠? 각성 한자로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 646200,
    "dDurationMs": 9199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그니까 한자는이 각성은 사실은 그\n영화의 또는 웨이크니스 이거를 번역한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 653040,
    "dDurationMs": 9720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "말인데 한자로 쓰면 상당히\n재밌습니다.이 깨달을 각자를 써요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 658000,
    "dDurationMs": 12839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "각 그다음에 성은 뭐냐면요 옆에 술\n주자 있죠? 술 주자의 별 성자.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 666079,
    "dDurationMs": 10560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 어 술을 먹고 별을 보면 술이\n깨나 봐요. 예. 또는 별이 보일",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 674000,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "때까지 술을 먹는 건가? 어쨌든 술\n깰 성입니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 678800,
    "dDurationMs": 8159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러니까 술 채했다가 이렇게 술 깨는\n거 그게 각성이에요, 사실은.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 684959,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 잠에서 깨는 것도 각성인\n거죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 688839,
    "dDurationMs": 9921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런데 불면증의 핵심 병리 상태는이\n각성이 지나치게 일어나는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 695200,
    "dDurationMs": 8920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하이퍼 지나치게 하이퍼라우스이 되는\n거죠. 과각성은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 700839,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "언제 일어나냐? 외부의 위협이나 내일\n뭘 잘못할지 잘못될지도 몰라 하는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 706279,
    "dDurationMs": 9240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "위기 그거로부터 내 삶을 방어하기\n위해서 그래서 위협으로부터 방어하는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 712920,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시스템이 뭐죠? 편도체 활성화,\n교감신경계",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 717240,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "얘가 켜지는 거죠. 또 편도체\n나왔어요. 그래서 편도체 안정화해야",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 723279,
    "dDurationMs": 7921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아, 각성 상태 좀 벗어나겠구나.\n예, 맞아요. 그거에 대한 구체적인",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 728600,
    "dDurationMs": 8799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "좀 테크닉을 오늘 좀 알려 드리려고\n하는 겁니다. 그래서 사실은 편도체",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 734240,
    "dDurationMs": 7599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "안정화 훈련 여러 가지 내면 소통 그\n체계 안에 있죠. 어 호흡",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 740120,
    "dDurationMs": 7719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "알아차리기도 있고 내부 감각\n알아차리기도 있고 뇌신경계 이완도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 744079,
    "dDurationMs": 8361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있고 미주신경 호흡도 있고 그 저기\n뭐야 고유 감각 알아차리는 것도 있고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 749760,
    "dDurationMs": 7879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "등등등 많이 있습니다. 소매틱\n엑서사이즈도 있고 그런게 다 편도체를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 754880,
    "dDurationMs": 6600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "안정화시키기 때문에 그런 예를 들면\n소매틱 엑서사이즈",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 759800,
    "dDurationMs": 8960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "태국권이나\n어떤 요가 같은 거를 쭉 한 날은 잘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 765959,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "주무실 거예요. 생각해 보시면 그래서\n그런 것들이 편도체 안정화다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 771639,
    "dDurationMs": 10560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이렇게 이해하시면 되겠어요. 불면의\n불면의 각성은 불안과 통제 욕망에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 778800,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "포획된 오염된 각성이에요. 고요함을\n상실한 채 스토리텔링 경험자가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 784560,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "만들어내는 스토리텔링 소음에 휘말린\n거죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 789360,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "명상 전통에서 규명하는 거는\n깨달음이란 거 있잖아요. 아 그 사람",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 794720,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "깨달은 사람이야. 그것도 각자를\n씁니다. 깨달을 각. 그래서 모든",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 801199,
    "dDurationMs": 7561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "인위적인 통제 시도와 미래에 대한\n불안, 과거에 대한 반추 이걸",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 806440,
    "dDurationMs": 9320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내려놓고\n있는 그대로 지금 이대로 현상 있는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 812000,
    "dDurationMs": 12279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그대로 그대로 바라보는 텅빈 고요 한\n상태 그걸 깨어 있다고 해요. 그래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 819839,
    "dDurationMs": 9921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불교 명상 전통의 궁극정이 궁극적인게\n보디 붙다거든요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 826800,
    "dDurationMs": 9399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "산스크리트어 붙다는 깨어났다는\n거예요. 각 그래서이 한문엔",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 833600,
    "dDurationMs": 9799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "번역에서는 붙따를 붙여 말이죠.\n붙다를 예전에부터 어떻게 번역했냐?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 839800,
    "dDurationMs": 8959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "각 자하로 번역했어요. 깨달은이\n놈자써서 깨달은 사람이란는 뜻이죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 845800,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그게 붙다라는 뜻이에요. 장자에서도\n깨달음이 나옵니다. 대각이 있을려면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 855680,
    "dDurationMs": 10760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "또는 대각이 있는 그것이 큰\n꿈이었음을 대몽이었음을 안다. 즉",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 863199,
    "dDurationMs": 9080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "꿈에서 깨어나야 그게 꿈이 꿈이었음을\n안다 하는 거죠. 그래서 이런 명상",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 868880,
    "dDurationMs": 8920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "전통에서는 뭐 어 이런 그 불교도\n그렇고 어디 다 명상 전통에서는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 876000,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "깨어 있어라.\n깨어나라.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 879800,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "예. 그거를 어이 깨달음이라고 하는\n거죠. 그래서 그 그런 점에서 보면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 885560,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "각성은음\n우리 정신없이 사는 삶을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 890360,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일장 춤이라고 본다면 거기서부터\n깨어나는 거 그건 좋은 거죠. 근데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 895680,
    "dDurationMs": 7279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그거 말고 우리가 지금 다루는 건\n불면증 과각성이니까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 900199,
    "dDurationMs": 7921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 깨달음이 아닌 거죠. 그 그\n얘기는 아닌데 아무튼 그 깨달을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 904360,
    "dDurationMs": 9880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "각자가 나와서 한번 말씀을 어\n드려봤고요. 결국 불면증의 문제는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 910680,
    "dDurationMs": 9159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐냐면 과각성이 문제다는 거죠.\n2000년 2010년에 와서이 연구가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 916440,
    "dDurationMs": 8280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "많이 됐지만 사실은이 개념의 출발점은\n많은 연구들이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 922320,
    "dDurationMs": 8999,
    "wWinId": 1,
    "segs": [ {
      "utf8": "최근에 나오는 많은 연구들이 이렇게\n그 원로 또는 오리지널로 언급하는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 928360,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "연구가 1967년도의\n먼로의 연구입니다.이 이 먼노는 잘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 934600,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자는 사람. 굿leers 푹 잘 자는\n사람과 잘 못 자는 사람 자꾸 수면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 939480,
    "dDurationMs": 7919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "장애 겪는 사람들을 실제로 수면\n실험실에서 비교하는 그 측정을 해",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 944920,
    "dDurationMs": 8719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "봤어요. 거의 최초의 이런 연구죠.\n나쁜 수면자는 잘 못 자는 사람은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 950920,
    "dDurationMs": 11039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠자리에 누워 있는 입면 전 시간뿐만\n아니라 실제로 뇌파상 보면 이게 잠든",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 957199,
    "dDurationMs": 12120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뇌파예요. 그런데도 수면 시간 내내이\n코 템프러 직장 체원으로 된 바디",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 965399,
    "dDurationMs": 11081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "코바디 템프러추에 그 신부 채온이 더\n높았고 신박수랑 말초혈관 수축 반응이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 973440,
    "dDurationMs": 9759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "현재 항진돼 있으며 즉 교감 신경이\n활성화된 거죠. 교감경 활성화도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 979079,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "전체적으로 높았고 게다가 밤새 신체\n움직임과 에너지 소비가 유회하게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 986040,
    "dDurationMs": 8279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "많았다. 그러니까 우리가 생각하는 잠\n잘 못 자는 사람, 잠을 설치는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 990800,
    "dDurationMs": 10640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "사람의 특징을 그대로 보인 거죠.\n즉이 푸어 슬리퍼즈들은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 997920,
    "dDurationMs": 8359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "신체는 수면 중에도 사실은\n생리적으로는 각성 상태에 근접해",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1004639,
    "dDurationMs": 7521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있었던 거예요. 몸이 좀 깨 어느\n정도 깨어 있는 거예요. 1990년대",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1009319,
    "dDurationMs": 10520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "와서 비슷한 연구가 또 일어납니다.\n불면증 환자의 24시간 대사율이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1016160,
    "dDurationMs": 10279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "밤낮으로 정상 수면자보다 높다는 그런\n연구가 나옵니다. 다시 말해서 잠을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1023120,
    "dDurationMs": 7679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잘 못 자는 사람은 24시간 내내 더\n많은 에너지 태우고 있는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1028919,
    "dDurationMs": 7361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그리고 이제 실험을 한 거예요.\n여기서 잘 자는 사람. 음. 잠",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1033240,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "멀쩡하게 잘 자는 사람한테 과각성을\n일으켜 한 거예요. 그래서 과성",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1039039,
    "dDurationMs": 5800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일으키는 실험 그 뭘로 과각성\n일으켰냐? 커피로 한 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1043280,
    "dDurationMs": 7560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "카페인을\n하루 세 번 카페인 400mmg씩.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1049080,
    "dDurationMs": 7160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러니까 이거 굉장히 좀 세게 모은\n거죠. 그래서 1,200g을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1054240,
    "dDurationMs": 10160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1200mg을 1200g이 아니에요.\n죄송합니다. 400mg 1200mg을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1060360,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "매일 먹게 400mg씩 한번 먹게.\n보통 커피 한 잔에 150에서 한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1067640,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "200mg 그 정도 들어 있을\n거예요. 400mmg이면은 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1072200,
    "dDurationMs": 10120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자체로도 꽤 많은데 그걸 하루에 세\n번씩 게다가 일주일 동안 매일 7일간",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1078880,
    "dDurationMs": 9120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "연속 그랬더니 어떻게 되느냐? 잠을\n자도 밤에 불면증과 비슷한 수면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1085840,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "변화가 나타나요.\n그래서 만성이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1091159,
    "dDurationMs": 10721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증은 뭐냐면 몸 안에서 스스로\n카페인 만들어내는 상태랑 비슷하다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1098159,
    "dDurationMs": 9361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이렇게 보시면 돼요. 커피 안 먹고도\n각성 상태 들어가는 그 상태다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1104480,
    "dDurationMs": 9199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이렇게 보시면 되고 또 한 가지이\n실험을 통해서 보여 주셨듯이 보여",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1109919,
    "dDurationMs": 9841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "드렸듯이 커피를 많이 드시면 수면에\n무조건 방해됩니다. 무조건",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1116480,
    "dDurationMs": 9600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "무조건 방해가 돼요. 아침에 조금\n마시는 정도 그거는 좀 그래도 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1124280,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "영향을 주는데 커피 하나도 안 마셔야\n영향을 안 받고 카페인을 아침에 조금",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1130159,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "마시면 밤까지 영향을 주긴 줘요.\n오후에 마시면 오후에 마시면 더욱더",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1134919,
    "dDurationMs": 7561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "영향을 주고요. 근데 그런 분들이\n있어요. 아 나 카페인 커피 마셔도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1139760,
    "dDurationMs": 8520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "난 잠 잘자. 근데 그런 분들에 대한\n연구도 어 다른 데서 나온 거 보면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1146120,
    "dDurationMs": 8439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "커피 마셔도 잠 잘자. 그러시는\n분들도 본인이 그냥 커피 마셔도 잠",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1151440,
    "dDurationMs": 9880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "들었다고 생각하는 거지. 실제 커피\n마셨을 때와 안 마셨을 때 밤에 자는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1158159,
    "dDurationMs": 8921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "패턴을 비교해 보면 다릅니다.\n더 뒤척이고 더 에너지 소이 많고 더",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1164840,
    "dDurationMs": 6600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "각성이 되는 거죠.\n그래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1168760,
    "dDurationMs": 10039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "커피를 꾸준히 많이 드시면\n어 불면증으로 갈 가능성이 상당히",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1174760,
    "dDurationMs": 9279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "높습니다. 그리고이 그\n과성의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1180360,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "정체를 한번 좀 더에 생각해 보도록\n하겠습니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1186360,
    "dDurationMs": 3000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1189400,
    "dDurationMs": 9320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "예 과각성의 생리적 상태는\n[목을 가다듬음] 신경 내분비계와",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1196120,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "정량화 q의지라고 하는 거 정량화된\n뇌파 그리고 기능적 뇌 영상에서도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1201559,
    "dDurationMs": 8201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일관되게 나타나요. 이거는 그냥\n뒤척이나 뭐 에너지 소비 뭐 이런 걸",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1206000,
    "dDurationMs": 9640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "정도 본 건데 이제 뇌 연구\n보면은 첫째 뭐냐면이 과각성이 된",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1212919,
    "dDurationMs": 7841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "상태에서는 먼저\n먼저 HP 축이라고 요건 최근에도 몇",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1218919,
    "dDurationMs": 8441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "번 말씀드렸죠.\n하이포라무스 하고 시상화보에서 거기서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1224280,
    "dDurationMs": 9800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "호르몬으로 피추리 글랜드 뇌화수체를\n땅 때려서 뇌화수체가 또 아드레날",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1230440,
    "dDurationMs": 7800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "글랜저 부신 피질 거기를 또 때려\n가지고 그다음부터 코르 나온다 이런",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1235880,
    "dDurationMs": 9159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거 그래서 HP축 그게 스트레스\n호르몬 나오는 그이 하나 X 엑스",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1242159,
    "dDurationMs": 9161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "축이다. 예. 얘가 얘 얘가 얘 그럼\n왜 그렇게 번거롭게 복잡하게 하나 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1247559,
    "dDurationMs": 10961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이유까지도 말씀을 드렸습니다. 자,\n불면장애의 대표적인 병리 상태는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1253679,
    "dDurationMs": 10721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐냐면이 HP 축에 과성화요. 즉\n한마디로 만성적인 스트레스 상태인",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1261360,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요. HP축이\n계속 만성적으로이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1268240,
    "dDurationMs": 8840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "막 과성화 돼 있으면\n과각성도 일어나고요. 수면 장애도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1273400,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "되고 이게 면역력도 낮추고 이게 그\n미토콘드리아 기능도 낮치고 하는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1279039,
    "dDurationMs": 8760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "얘기도 다 말씀을 드렸습니다.\n정상 수면자의 경우 스트레스 호르몬인",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1284919,
    "dDurationMs": 10921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "코르티솔과 부신피질 자극 호르몬\n분비는 기상 직후 최고조에 달한 뒤에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1291320,
    "dDurationMs": 12959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저녁 밤에 점점점 내려가죠. 만성\n불면 장애 환자는 24시간",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1300080,
    "dDurationMs": 11760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "혈중 코르티솔 분비량이 정상인보다\n높아 있어요. 특히 저녁 시간 때",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1307640,
    "dDurationMs": 10639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "야간 수면 전반부에 그러니까 그 야간\n수면 전반부라는 거는 뭐냐면 밤에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1314440,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠을 잘 때 전반부는 주로 디 슬립이\n일어나는데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1319840,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "후반부는 주로 새벽역 이럴 때 그때는\n램 수면이 주로 꿈꾸고 하는 거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1325039,
    "dDurationMs": 7721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일어나는 때입니다. 그래서이 앞에\n딥ep 슬립은 정말 업버가도 모른다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1330279,
    "dDurationMs": 8161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "할 정도 이제 깊이 자는 거. 어\n그거 한 1한시간 반 1한시간 15분",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1335919,
    "dDurationMs": 8841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1한시간 반 2두시간 그 정도 되면\n좋죠.이 딥ep 슬립 이게 완전히",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1341919,
    "dDurationMs": 8041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠드는 거. 근데 그때 코르티솔\n수치가 현저하게 높게 유지되는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1347400,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "겁니다. 굉장히 안 좋겠죠.\n야간 코르시설 농도가 높을수록 야간",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1352880,
    "dDurationMs": 10240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면 중 각성 빈도가 비례해서\n증가합니다. 그리고 불면증 환자는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1359880,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "비램 수면 중에서도 비램 수면이라는\n건 램 수면은이 꿈꾸구 래드",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1366600,
    "dDurationMs": 6800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아이브먼트 눈동자 왔다 갔다 갔다\n하는 거잖아요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1369760,
    "dDurationMs": 10680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 새벽력에 많이 생기는 그거 말고\n그거 말고 1단계 2단계 3단계 하는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1377159,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 뭐 딥ep 슬립 딥 슬립 들어가기\n전에 얕은 수면 시간이 훨씬 더",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1382799,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "길어요. 그래서 얕은 수면\n시간이라든지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1386520,
    "dDurationMs": 9840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "깊은 수면 시간 N2 뭐 N3 이렇게\n얘기하는데 그 얕은 수면이나 깊은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1392480,
    "dDurationMs": 10199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면 램 수면은 아니에요. 이쪽에서도\n베타파와 감마 감마파와 같은 고주파",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1399919,
    "dDurationMs": 8961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "활동이 이건 뇌파 얘기예요. 베타파\n감마파는 뇌가 깨 있을 때 나오는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1406360,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요. 특히 감마파는 이게 각성의\n뇌파예요. 그래서 베타파 감마파는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1411480,
    "dDurationMs": 8199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "주로 언제 이렇게 잡혀야 되냐면\n우리가 깨서 왔다 갔다 일상 낮에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1416640,
    "dDurationMs": 7519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돌아다닐 때 그때 베타파 잡히는게\n정상인 거고 그다음에 또 베타파",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1421799,
    "dDurationMs": 7321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "감마파 고주파가 언제 나오냐면 꿈꿀\n때 램 수면 때 나옵니다. 그래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1427320,
    "dDurationMs": 7839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "베타파 감마파 같은 건 램수면 때\n나와야 되는데 이런 고주파 그니까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1433200,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "20Hz 이상이죠. 감마판\n40Hz까지 되는 거고 베타판 한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1437200,
    "dDurationMs": 10839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "20Hz 이상이고 이런 고집밥 활동이\nN2 N3 B램에서도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1444679,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "쭉 딥ep 슬립할 때도 그럼 델타파\n같이 느린 외파만 있어야 되는데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1451120,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "페터 감마파가이에\n난 램스면 중에도 남아 있다는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1456960,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요. 그러니까 잠을 제대로 못\n잔다는 뜻이죠.이 이 고주파 활동이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1462039,
    "dDurationMs": 8961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "많을수록 잤는데 못 잔 거 같다 하는\n그런 수면 오지각 잔 이렇게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1469279,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "개운하지가 않아 막 이런 느낌이 나는\n거죠. 그게 무슨 얘기냐? 뇌 일부가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1473799,
    "dDurationMs": 9161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "계속 깨서 활동하고 있는 거예요.\n그래서 그게 진짜 이런게 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1479720,
    "dDurationMs": 10959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하이퍼라우드 과각성의 문제입니다.\n이런 불면증 환자의 뇌사의 특징은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1487919,
    "dDurationMs": 10401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐냐? 한번 보니까\n각성 상태와 N램은 난 수면 상태",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1495640,
    "dDurationMs": 7240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "에에서 그러니까 난 수면 상태는\n꿈꾸지 않는 거 그니까 얕은 수면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1500880,
    "dDurationMs": 7080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "또는 깊은 수면 요걸 다 합쳐서 그\n난이라 그래.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1504679,
    "dDurationMs": 10841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 수면 상태에서 국소 뇌 포도당\n대사율을 비교해 보니까 불명주 환자는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1511960,
    "dDurationMs": 8839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "깨 있을 때나 잠들어 있을 때나 모두\n뇌 전체에 포도당 대사율이 유의하게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1518559,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "높았다. 그게 무슨 얘기예요? 포도당\n대사율이 높았다는 건 에너지를 많이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1523559,
    "dDurationMs": 5480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "쓰고 있다는 거예요. 그게 무슨\n소리예요? 뉴론들이 열심히 일하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1527039,
    "dDurationMs": 6561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있다는 거예요. 그게 무슨 소리예요?\n잠들어 있는데 뉴론들이 열심히 일하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1530919,
    "dDurationMs": 7693,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있는 거예요. 쉬지 않고. 어.\n그러니까 이게 무 문제가 있는 거죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1536240,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그야말로 각성 상태인 거죠.\n\u003e\u003e [콧방귀]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1538799,
    "dDurationMs": 9961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e 각성 상태에서 B램 수면 상태로\n이행할 때 그래서 깨 있다가 N1,",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 1546399,
    "dDurationMs": 9721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "N2, N3로 이렇게 그 얕은\n수면으로 해서 이렇게 깊은 수면으로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1552039,
    "dDurationMs": 10201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이행할 때 정상 수면자는 뇌관,\n변현계, 피질의 대사율이 일제히 큰",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1559320,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "폭으로 감소합니다. 그니까 진짜 수면\n상태로 쫙 빠지는 거예요. 그래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1564360,
    "dDurationMs": 9840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "정정상 수면인 사람은 한마디로 좀\n뇌가 꺼지는 느낌. 그래서 변현계",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1571640,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뇌관 피질 이런 대사율이 에너지\n소모율이 쫙 큰 폭으로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1577760,
    "dDurationMs": 10919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내려가요.\n그리고 뇌파도 느려지고. 그러나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1583200,
    "dDurationMs": 12680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증 환자는 어센딩 상향 레티큘러\n액티브 시스템이 상향 망상 망상",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1592440,
    "dDurationMs": 10880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "활성계가 그게 뭐냐면 위로 올라오는\n신호 레 이게 레티큘라 액티브",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1599399,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시스템이 이게 어떻게 되냐면 이게 쫙\n켜지는 의식이 켜지는 거예요. 그래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1606600,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 켜지면 의식이 켜지는데 잠자는\n동안에 이게 자꾸 어느 정도 켜져",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1610279,
    "dDurationMs": 9601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있다 이거죠. 시상화부, 시상, 뇌서\n편도체, 해마, 전 대상 피질,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1616200,
    "dDurationMs": 10880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그다음에 MPFC에서까지\n포도장 대사율의 감소폭이 현저히",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1623799,
    "dDurationMs": 7281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "작았어요. 즉 불면증 환자는 뇌가\n계속",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1628760,
    "dDurationMs": 6279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "말면 엔진 돌아가고 있는 거예요.\n계속.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1632399,
    "dDurationMs": 8921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "포도장 대사 계속 하고 있는 거예요.\n즉 수면 중에도 높은 대사 활성도를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1638000,
    "dDurationMs": 8960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "유지했다. 그게 불면증 환자의\n특징이에요. 수면 진입 이후에도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1643520,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠들은 다음에도 뇌 각성 중추와\n중추와 정서 및 기억 회로가 작동을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1649320,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "멈치 못하고 계속 에너지 쓰고 있단\n말이에요. 셋째는 뭐냐? 주간에 깨어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1653960,
    "dDurationMs": 10480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있는 동안에는 불면증 환자의 양측\n전전두 피질의 광범한 영역과 좌측의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1661399,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "좌측의 상측협 두정협 후두엽 피질 뭐\n시상민 뇌관 망상제 일부 이런 데서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1667360,
    "dDurationMs": 8280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "상대적 대사 저하가 발견해 됐어요.\n그러니까 뇌 온갖서 상대적 대사",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1673279,
    "dDurationMs": 8201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저하가 발견됐어요.\n황당한 거죠. 이거 무슨 얘기냐면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1677720,
    "dDurationMs": 11160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "낮에 깨 있을 때는 뇌 뇌가 작동을\n잘 안 하고 엔진이 덜거락되고 작동을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1685279,
    "dDurationMs": 10520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잘 안 하고 에너지 대서 못 하고\n정작 잠 들어서 좀 쉬워야 될 때는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1693080,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠 못 들고 에너지 대사 에너지 소모\n계속 하고 있고 이런 거죠. 야간",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1698279,
    "dDurationMs": 11000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면 내내 각성 엔진이 꺼지지 않아\n에너지를 소진한 대가로 정작 주관에는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1706120,
    "dDurationMs": 9640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "낮에는 고차원적인 인지나 실행 통제\n기능 이거 수행해야 될 전전두 피질이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1712760,
    "dDurationMs": 7720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "기능적 탈진 상태에 빠져 있음이이\n뇌형이 연구로 입증된 거예요. 그래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1718200,
    "dDurationMs": 5839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠 못 자면 실제로 진짜이 연구를 해\n보니까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1722399,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "실제로\n멍하다 이런 거 있잖아요. 아, 나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1725960,
    "dDurationMs": 7599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠을 못 자서 아, 머릿속에 그냥\n안개낀 거 같고 브레인 포그 그냥",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1731679,
    "dDurationMs": 5880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "멍해.\n잠을 못 자서 그래. 이건 맞는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1735720,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "얘기. 그니까 느낌이 그런게 아니라\n실제로 뇌가이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1740320,
    "dDurationMs": 12040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "제대로 기능을 수행하지 못해요.\n그러면 낮에 그렇게 제대로 수용하지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1747000,
    "dDurationMs": 10240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "못하고 그럼 피곤하잖아요. 예.\n그래서 낮에 잘 머리가 안 돌아간다이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1753799,
    "dDurationMs": 7841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "말이야. 진짜 멍하고\n그러면은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1758919,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증 환자는 낮에 졸릴까요?\n여러분 불면 불면증 환자가 낮에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1764080,
    "dDurationMs": 5640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "졸릴까요? 안 졸릴까요?\n아이 뭐 낮에 졸리겠죠. 밤에 잠 못",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1768320,
    "dDurationMs": 7719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잤으니까.\n그런데 이게 역설적인 명제입니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1772519,
    "dDurationMs": 8081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증 환자는 낮에 안 졸려요.\n잘하고 뉘어도 못 자요. [웃음]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1778559,
    "dDurationMs": 7401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 이게 문제예요. 자, 불면증\n환자들은 전날 밤 수면 시간이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1782840,
    "dDurationMs": 7679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "부족해서 낮동안 극도로 졸리고\n피곤하다고 호소해요. 그러나 수면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1788600,
    "dDurationMs": 6959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "의학적으로\n피곤한 거 있죠. 피로. 어우,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1792320,
    "dDurationMs": 8680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "피곤해. 그거랑 슬리피니스는 완전히\n다른 겁니다. 그러기 때문에 오늘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1798440,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "강의 제목이 뭐예요? 피곤한데 왜\n잠들지 못할까? 그러니까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1804720,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "for티곤해.\n정말 피곤해. 그런데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1809919,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어떻게 되냐? 슬리피니스가 없는\n거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1814279,
    "dDurationMs": 9760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "멍한데 잠이 안 오는 거예요. 피로는\n신체적 정신적 에너지가 고갈되어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1821360,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "무력하고 탈진한 주관적 상태 이게\n피곤한 거예요. 전전두피질 대사 저화",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1827840,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저하의 대응이 전전두피질 대사가 툭\n떨어져 있으니까 피곤하게 느끼는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1832600,
    "dDurationMs": 9600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요.\n그런데 슬립 슬리피니스",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1838880,
    "dDurationMs": 10600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "졸린 거는 실제로 수면 단계로\n진입하는 객관적인 생리적 수면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1845720,
    "dDurationMs": 9280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "경향성을 의미해요. 불면증 환자는\n요게 부족한 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1852360,
    "dDurationMs": 9640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "MSL 테스트라고 했습니다. MSL이\n뭐냐? MSLT라고 불리는 거.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1857159,
    "dDurationMs": 10961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "MS이 뭐냐면 미인 평균 슬립 레이턴\n레이턴 한마디로 누워서 자려고 누워서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1865840,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "누웠는데 잠드는 데까지 걸리는\n시간입니다. 레이턴스가 길다 그러면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1870720,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자려고 누웠는데 잠이 안 온다 이런\n뜻이에요. 그 그거 평균값을 뭐 미",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1876120,
    "dDurationMs": 8559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "슬립 레이턴스 뭐 주간에 두시간\n간격으로 주간에 두시간 간격 그럼",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1882120,
    "dDurationMs": 7519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "낮에 말이에요. 아침 10시 뭐 낮\n뭐 낮 12시 오후 2시 오후 4시",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1887600,
    "dDurationMs": 8679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "오후 6시 뭐 이렇게 하루 종일\n2시간 간격으로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1892039,
    "dDurationMs": 12081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "4 5차례 어둡고 조용한 검사실\n침대에 누워서 실제로 잠들 때까지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1900279,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "소요되는 평균 수면을 재보는 겁니다.\n그러니까 불면증에 시달리는 사람한테",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1906679,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그냥 뭐\n자꾸 부르는 거죠. 두 시간 관계일로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1911440,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "와 보세요. 그리고\n어둡게 하고 조용하게 하고 잠 잘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1916000,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "오게 해서 한번 누워서 주무세요.\n이렇게 하는 거예요. 그래서 얼마나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1921440,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "빨리 잠드나 보는 거예요.\n수면이 박탈된 정상인이나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1926840,
    "dDurationMs": 7439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어 그까 잠을 잘 원래 불면증 없고\n정상적인 사람인데 하루 잠을 안",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1932399,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "재워요. 그럼 막 졸리겠죠. 그런\n사람이나 폐쇄성 수면 무업증 막",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1937480,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "코오는데 이렇게 걱히는 사람 있죠.\n또는 김연증 환자 이런 사람은 주관",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1942919,
    "dDurationMs": 8600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "MSLT 얼마나 빨리 잠든하는\n테스트에서 해보면 뉘어놓으면 5분",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1948440,
    "dDurationMs": 11640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "8분 내에 잠에 듭니다.\n그런데 전날 밤 완전히 잠을 설치",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1956559,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "만성 불면장의 환자들은\n낮에 침대에 눕게 해도 잠들지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1963200,
    "dDurationMs": 9319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "못해요.\n오히려 정상적으로 수면 이렇게 잘 잔",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1968600,
    "dDurationMs": 7439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "대조군보다 평균 수면 잠복기가 더\n길게 나타나요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1974399,
    "dDurationMs": 6681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "전날 밤 그냥 잠 잘 잤어. 그런\n사람도 뉘어 놓으면 졸리니까 잠",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1977760,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "들잖아요. 어둡고 조용하고 그러면.\n근데 그런 사람보다 잠 잘 잔",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1983840,
    "dDurationMs": 10040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "사람들보다 잠 하나도 못 잔 불면증\n환자가 더 잠이 안 들어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1990960,
    "dDurationMs": 9800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "심지어 이게 상관 관계가 있는데 어떤\n관계가냐면 야간 총수면 시간이 짧은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 1997279,
    "dDurationMs": 8841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증 환자일수록 다음날 주간\nMSLT에서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2002320,
    "dDurationMs": 8680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠데 걸리는 시간이 더 길어졌어요.\n무슨 무슨 얘기냐면 한 4네시간밖에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2008880,
    "dDurationMs": 7159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "못 잔 사람이\n뭐 15분 만에 잠들었다고 치면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2013559,
    "dDurationMs": 6401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3시간 두시간밖에 못 잔 사람은\n20분 30분 돼도 잠이 안 드는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2017919,
    "dDurationMs": 8561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요.\n수불 수면 시간이 짧은 사람일수록 더",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2023679,
    "dDurationMs": 8360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "오래 걸려 잠드는데 이게 불면증\n환자의 괴로움이죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2029240,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "야간의 인면을 가로막았던 바로 그\n중추신경계",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2033600,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "과학성 시스템이\n주간에도 24시간 내내 꺼지지 않고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2038760,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돌아가니까 그러니까이 사람은이이\n불쌍한 불면증 환자는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2043960,
    "dDurationMs": 7639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "과각성 상태가 계속 되고 있는\n거예요. 그래서 낮잠 잠을 못 드는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2049919,
    "dDurationMs": 7641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거죠.\n신체와 전 피질은 에너지가 고갈돼서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2054760,
    "dDurationMs": 9319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "진짜 지쳐 있지만 뇌간 시상화부\n교감신경계의 각성 회로는 계속 비상",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2060839,
    "dDurationMs": 8961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "알람 올리면서 편도체도 그렇고 계속\n과열돼 있어서 휴식을 허용하지 않는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2066960,
    "dDurationMs": 10439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "상태죠. 이게 만성 불면장의\n신경 생리학적 실체입니다.이 정도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2073240,
    "dDurationMs": 9960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "되면은 정말 괴로운 상태 에인 거고이\n정도까진 아니어도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2080240,
    "dDurationMs": 10359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "좀 비슷하신 분음 나 가끔 절래\n이러신 분도 상당히에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2086679,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "많으실 거예요.\n그러면은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2092599,
    "dDurationMs": 7321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 스트레스 받아서 잠 못 자는\n사람이 다 불면증 걸리냐? 그렇지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2096639,
    "dDurationMs": 9681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "않아요. 한 10% 어 10%나\n15% 그 정도만",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2102760,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "만성 불면증 환자가 됩니다. 그러면\n불면증을 좀 시달리다가 좀",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2108200,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "괜찮아지기도 하는데 대부분은\n괜찮아져요. 불면증에 며칠 시달리다가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2112640,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런데 어떤 사람들은 며칠 불면증\n시달리다가 그 계속 가는 거예요. 몇",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2117720,
    "dDurationMs": 7600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "달이고 심지어 몇 년까지 가요. 몇\n년.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2121280,
    "dDurationMs": 8920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러면이 만성 불면증이\n되는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2126960,
    "dDurationMs": 8080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 메커니즘이 뭐냐? 그니까 여러분\n조심하셔야 돼요. 이렇게 안 되도록.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2132880,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 그걸 또 이렇게 좀 체크하셔야\n돼요. 이건 만성 불 어 만성",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2137800,
    "dDurationMs": 8760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증으로 가는 그 과정에 대한\n이론입니다. 흔히 3P 모델이라고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2144960,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하죠.\n그래서 어 일단 이렇게 보세요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2149400,
    "dDurationMs": 8360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "요인이 세 가지가 있어요. 3P가\n세 가지 P예요. 뭐냐면 처음에는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2155680,
    "dDurationMs": 8639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "pr디posing\n팩터 pr디posing이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2160400,
    "dDurationMs": 8520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "첫 번째 피고 두 번째에\n피는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2166000,
    "dDurationMs": 10880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "두 번째 p는 prcipt이팅\n유발하는 피고 세 번째 피는 퍼펙추에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2173720,
    "dDurationMs": 7960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "벡터를 지속하는요 세 가지가 뭔지\n잠깐 좀 설명을 드릴게요. 자, 몸이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2180079,
    "dDurationMs": 5641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아프거나\n심하게 싸우거나 대인관계 갈등을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2183680,
    "dDurationMs": 8280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "겪거나 상실이 있거나 뭐 직장에서\n무슨 업무 플러스 인간관계 갈등을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2188400,
    "dDurationMs": 9199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "겪거나 뭐 어떤 위협을 느끼거나 막\n수험생들 시험 걱정하거나 이러면은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2195000,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 이제 일종에 급성 스트레스예요.\n그러면 이런 거를 겪으면 너무 화가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2200040,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나고 말이에요. 대인관계 갈등 심하게\n겪고 막 이러면은요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2205040,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "며칠 잠 못 자요.\n그 완전 불면증처럼 돼 버려요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2209599,
    "dDurationMs": 6841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 급성 스트레스를 이게 신체가\n그 몸에 알람이 다 켜지니까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2215235,
    "dDurationMs": 8205,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[목을 가다듬음]"
    }, {
      "utf8": " 각성 상태가 되는\n거죠. 그럴 때 며칠 또는 심하면 뭐",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2221520,
    "dDurationMs": 7799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "한두 주\n수면 장애가 발생하는 건 정상이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2226599,
    "dDurationMs": 8041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러니까 여러분 이게 지금 너무\n겁내지 마셔야 될게 아 내가 몇 달",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2232720,
    "dDurationMs": 7080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "전에 내가 잠 못 잤어. 한 며칠 잠\n못 잤지. 그런 건 진짜 괜찮아요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2237640,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "예. 너무 걱정 안 하셔도 돼요.\n근데 거기서 조금 잘못 가면이 만성이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2242640,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "될 수가 있어요.이 만성되는 건\n막아야 돼요. 그래서 언제 만성 어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2247440,
    "dDurationMs": 9200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증이 되는가를 지금 잘 이해해\n두시기 바랍니다. 보통은요. 대부분",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2254119,
    "dDurationMs": 8401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러한 스트레스 요소가 좀 해소가\n되면 다시 정상수면 패턴을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2259599,
    "dDurationMs": 11000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "회복합니다. 그런데 이런 불면 장애\n단 며칠이라도 불면 장애를 겪었던",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2265560,
    "dDurationMs": 11480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "사람 중에 약 10%에서 16%는\n수개월에서 수십년간 지속되는 만성",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2274359,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증으로\n이게 이행합니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2279640,
    "dDurationMs": 8679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "만성화 과정을 설명하는 대표적인\n이론이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2284480,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "스피만 등의 3P 지금 말씀드린 3P\n모델이에요. 수면 역시 모델이라고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2290160,
    "dDurationMs": 6600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불리우는 거. 첫째는 뭐냐면\n프디스포징. 뭐냐면 원래 좀 그런",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2294960,
    "dDurationMs": 8840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "성향이 있다. 이런 거예요. 그런\n소인적 요인이 좀 뭐 유전적일 수도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2299160,
    "dDurationMs": 9840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있고 원래 좀 그래. 그게 원래에 그\n사람이 지니고 있는 생물학적 유전적",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2306640,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "심리적 취약성을 얘기하죠. 쌍둥이\n연구에 따르면 불면증의 유전율이 한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2312520,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "40%에\n달합니다. 그니까 유전자가 비슷하면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2316920,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어 그렇게 한쪽 쌍둥이 한쪽에 걸리면\n40% 걸릴 수가 있다. 이런 거죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2322240,
    "dDurationMs": 10520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "또 133만 명 이상의 유전체를\n분석한 대규모 전장 유전체 연관 분석",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2329240,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그거는 온갖 그 유전체를 갖다 놓고\n특정한 증상이나 이런 거랑",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2334960,
    "dDurationMs": 6879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "코릴레이션을 마구 돌려 버리는 뭐\n걸리려면 걸려라 이런 식으로 하는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2339400,
    "dDurationMs": 8959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런 연구 어떤 이론도 없고 그냥\n마구 돌려보는 이런 거죠. 그걸 해본",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2345200,
    "dDurationMs": 9720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "결과 불면증 위험 유전자들은\n일주기 리듬이나 아까 얘기했던 수면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2351040,
    "dDurationMs": 10920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "항상성 유전자 그 아데노신 뭐 하고\n이런 거 그런 거보다는 대네피질과",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2357760,
    "dDurationMs": 9120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "선조체 시상화부등 정서 반응성과\n현저성 네트워크를 조절하는 신경",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2364520,
    "dDurationMs": 8440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "회로에 집중적으로 발현되 있음이\n밝혀졌어요. 다시 말해서 불면증 위험",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2369960,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "유전자들은 어디에 있냐? 일주기\n리듬을 깨냐? 그런 거 있거나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2375560,
    "dDurationMs": 7960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아니면은 그 아데노신 수면 항상성\n슬립 프레셔와 관계된 메커니즘 그걸",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2380280,
    "dDurationMs": 10319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "깨거나 하는데 있지 않고 오히려 어디\n있느냐 하면은 네네피질 선조체",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2386960,
    "dDurationMs": 9520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "즉 정소 반응성이 예민한 거 또는\n현저성 네트워크라고 해서 SN 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2393680,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내면소통 책에 보면 자세하게\n나옵니다. 어떤 중요한 일이에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2398720,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "벌어지고 중요한 상태라고 했을 때 쫙\n그 에너지를 글로 모아서 쓰는 그런",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2404280,
    "dDurationMs": 11440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "현저성 네트워크 그 저기 센트럴\nexecut티브 네트워크랑 그다음에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2410319,
    "dDurationMs": 10961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "DMN에 디폴트 네트워크랑\n그거랑 그 현성 네트워크이 세 가지가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2419200,
    "dDurationMs": 9480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "세 가지 글로벌 네트워크다 이런\n얘기가 거기 설명이 돼 있습니다. 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2423599,
    "dDurationMs": 10681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "바로 현조성 네트워크 거기에 이런 그\n불면증을 유발하는 유전자들이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2431400,
    "dDurationMs": 8360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "집중적으로 발현되 있다. 이렇게에\n밝혀 밝혀졌습니다. 수면 반응성이란",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2437040,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런 건 뭐냐? 수면 반응성은 동일한\n스트레스에 노출되었을 때 수면 체계가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2443079,
    "dDurationMs": 9681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "교환되는 기질성 민감성을 얘기합니다.\n그러니까 비슷한 스트레스를 받아도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2449359,
    "dDurationMs": 6921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "굉장히 불안감이 올라가고 반추 성향을\n지녀 가지고 자꾸 머릿속에 그 생각이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2454720,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돌아가고\n이런 사람은 더 어 불면증이 올",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2460440,
    "dDurationMs": 7960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가능성이 있다 이거죠. 그런데 여기서\n중요한 점이 있습니다. 그런 수면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2464480,
    "dDurationMs": 11080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "반응성이 높고 유전적으로 그런게\n있어서 다시 말해서 프리디스포싱",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2471920,
    "dDurationMs": 9159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런 경향이 미리 있다고 해도\n이것만으로는 만성 불면증이 발병하지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2479359,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "않습니다.\n그러니까 너무 걱정하지 않으셔도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2482560,
    "dDurationMs": 11640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돼요. 요인이 두 가지가 더 채워져야\n돼요. 뭐냐면 이제 이게 유발 요인데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2491839,
    "dDurationMs": 7881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면 역치를 넘게 만드는 급성\n스트레스 사건 어큐트 인소니아가 직접",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2497400,
    "dDurationMs": 8439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "생겨야 돼요. 다시 말해서 그렇죠.\n원래 좀 민감하고 원래 유전적으로 어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2503920,
    "dDurationMs": 7320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐 스트레스에 대해서 확 반응하는\n사람 그 원래 그래야 되고 근데 원래",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2509160,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런 사람한테 굉장히 스트레스 받는\n일이 일단 생겨야 돼요. 그렇죠?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2513720,
    "dDurationMs": 7639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그게 두 가지. 그다음에 한 가지\n요건이 더 충족돼야 돼요. 자, 두",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2518599,
    "dDurationMs": 9921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "번째 요건은 이거예요. 그 어떤\n스트레스 받는 이거 가장 빈번한게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2525800,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "직장민 업무 스트레스입니다. 그런데\n직장민 업무 스트레스를 분석해 보면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2531160,
    "dDurationMs": 7439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 안에 인간 관계, 뭐 직장\n상사와의 관계, 에, 팀원과의 관계",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2536160,
    "dDurationMs": 7919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런게 다 들어 있습니다. 그래서\n업무 스트레스, 순수한 업무 스트레스",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2541319,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "많은 사람을 그렇게 많은 스트레스를\n주지 않습니다.이 직장민 업무",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2546280,
    "dDurationMs": 7720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "스트레스는 [목을 가다듬음] 인간관계\n요소도 항상 동반되기 마련이다. 요거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2550960,
    "dDurationMs": 10280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하나 이해해 두시고 그다음에 건강상의\n문제나 통증 참 이게 또 많이 어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2558920,
    "dDurationMs": 7960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증을 유발시킵니다.\n그다음에 가까운 사람과의 대인 관계",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2563480,
    "dDurationMs": 10240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "문제, 가족 및이 대인 관계 문제.\n요런 정도가 제일 스트레스인 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2570760,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "사람 불면증을 유발하는 크게 보면\n이렇게 보시면 돼요. 뭐냐면 요건",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2576000,
    "dDurationMs": 9960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가족민 대인 관계고 요건 직장 동료\n거래처 뭐 조직원 뭐 직장에서의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2582400,
    "dDurationMs": 10400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "대인관계 요인이에요. 그래서 한마디로\n불면증 촉발하는 건 누굴 미워하거나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2589400,
    "dDurationMs": 9959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "누구랑 싸우거나 누굴 원망하거나 하는\n인간관계 문제가 반 이상이고 그다음에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2596839,
    "dDurationMs": 8841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그냥 건강상의 문제, 통증 이런\n거예요. 중요한 것은 유발 요인에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2602520,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "의해 발생하는 급성 불면증은이\n질병이나 뇌의 기능 부전이 아니라",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2608119,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지극히 정상이에요. 이런 스트레스\n받아서데 어디가 아파 가지고 불면증",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2612720,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거는 지극히 정상인 거예요.\n그러니까 이게 이제 뭐 진화론 쪽으로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2617640,
    "dDurationMs": 9439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "볼 때 원시 자연환경에서 환경적\n위협이 감지되었을 때도 쿨쿨 아주 잘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2623760,
    "dDurationMs": 10079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자. 그런 사람은 그런 개체는 도태된\n거죠. 자꾸. 근데 위험이 감지되었을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2630079,
    "dDurationMs": 8321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "때 잠을 잘 깊이 못 자고 각성돼\n있어. 그런 개체가 살아남은 거죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2637000,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 이제 진화론 쪽으로 그렇게\n됐다 이런 거죠. 위협이 감지되었을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2640559,
    "dDurationMs": 9681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "때 수면 진입을 유회하고 각성을\n유지하는 능력은 인류의 생존을 담보한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2647040,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "진화적 방어 기재다. 이런 거죠.\n그래서 스트레스 상황에서 수일간 잠을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2652160,
    "dDurationMs": 5959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이루지 못했다고 그래서 뇌가\n손상되거나 나 뭐 불면 환자되거나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2655559,
    "dDurationMs": 5881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나한테 뭐가 이상이 있거나 이렇게\n두려워하거나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2659920,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자책할\n근거는 전혀 없습니다. 예. 그거를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2663920,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잘 어 그 이해하시기 바랍니다.\n그래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2668880,
    "dDurationMs": 8760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "한마디로 말해서 뭐냐면 안심 이건요\n안심을 하시라는 뜻입니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2674880,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "급성 스트레스로\n잠을 며칠 못 자게 되면 당연한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2680400,
    "dDurationMs": 8199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거라고 생각하세요. 예. 불안해 하지\n마시고. 중요한 거는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2686160,
    "dDurationMs": 11040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "만성으로 넘어가는데 제일 중요한\n요인은 세 번째 요인입니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2692160,
    "dDurationMs": 9159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "팩터라고. 지속하는 피입니다. 발표\n뭐냐면 유발 요인이었던 급성",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2699359,
    "dDurationMs": 7321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "스트레스가 해결이 됐어요. 그래서\n상황이 잘 적응했어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2703559,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "근데 불면이 자연 해소되지 않고 만성\n불면장어로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2708599,
    "dDurationMs": 9401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "고착되는 원인은 뭐냐면요.\n뭔가 하는 거예요. 무슨 얘기냐면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2715119,
    "dDurationMs": 9121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지소 교인이 뭐냐면 급성 불면으로\n발생한 수면 결핍을 보충하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2722119,
    "dDurationMs": 7641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내 수면을 내가 어떻게 좀 잠을\n자야겠다라고 해서 환자 스스로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2727160,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "채택하는\n나쁜 행동들이 있어요. 부적 대처",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2732319,
    "dDurationMs": 6321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "행동과 역기능적 인지수관. 그게 무슨\n얘기냐면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2736880,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자기는 나름대로 내가 지금\n불면증이니까 잠을 잘 자 보려고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2741520,
    "dDurationMs": 8319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런저런 노력을 합니다. 그게 다\n불면증 만성 불면증으로 가는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2746880,
    "dDurationMs": 9760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "길이다.이 이의 연구예요.\n예를 들면 예를 들면 이런 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2752920,
    "dDurationMs": 9439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "전날 밤에 수면 부족을 만해하기\n위해서 전날 밤 잘 못 잤어. 오늘은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2760319,
    "dDurationMs": 6441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일찍 자야지. 그래서 초저녁부터 일찍\n침대 누워 있거나. 근데 잠을 잘 못",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2765040,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잤어. 그래서 아침 기상 시간\n이후에도 늦게까지 침대해서 안 나오고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2768720,
    "dDurationMs": 6920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "계속 누워 있거나\n아나요 나 요새 너무 수면 무족이야.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2773160,
    "dDurationMs": 5840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 틈날 때마다 낮잠을 자려고\n시도하거나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2777280,
    "dDurationMs": 6079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "또는 아 나 잠 잘 못 자서 좀\n쉬어야 돼. 신체 활동을 계속 줄여",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2781079,
    "dDurationMs": 6401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나가거나\n게다가 플러스 오늘도 못 자면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2785480,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어떡하나 하는 걱정.\n지금 요런 행동을 하시잖아요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2791359,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런 행동이\n불면증을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2795200,
    "dDurationMs": 8639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "고착화시키는 행동들입니다.\n그걸 좀 더 설명을 드릴게요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2800839,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일단 요거 맞저 보시면 일단 이러한\n행동들은 깨어 있는 시간에 비례해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2806240,
    "dDurationMs": 7839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "축척되는 항상성 수면 압력을\n희석시킵니다. 그게 뭐야? 아데신이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2811839,
    "dDurationMs": 7081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "쌓이고 뭐 이거 돼야 되고 일주일이도\n뭐 해야 되는데 낮잠주 잘려 그러던가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2816400,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아니면 막 초전보다 잘려 그러던가\n수면 시간 느려야지 늦게까지 누워",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2820760,
    "dDurationMs": 8599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있다든가 아무때나 자려 그러고 막\n이런 거 그러면 어떻게 되냐면이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2826800,
    "dDurationMs": 7840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일주일 리듬 멀쩡하던 일주의 리듬도\n자꾸 깨는 행동을 하는 거고 항상선",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2831880,
    "dDurationMs": 8080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면 합력 이것도 자꾸 깨는 행동을\n하는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2836640,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 궁극적으로 침대와 각성 사이\n조건을 형상한다. 이게 문제예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2842077,
    "dDurationMs": 5762,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[목을 가다듬음]"
    }, {
      "utf8": "\n이건 좀 있따 또 설명드릴게요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2844680,
    "dDurationMs": 9360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "침대와 각성 사이의\n조건화 이거예요. 한마디로 뭐해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2850599,
    "dDurationMs": 10561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런 잘못 노력을 하면 뭐가 되냐면\n침대에 누으면 잠깨요.이 상태가 되는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2856880,
    "dDurationMs": 9840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "겁니다. 요약하면 급성 불면은\n스트레스가 유발해요. 근데 만성",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2864200,
    "dDurationMs": 7600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면은\n사 잠을 보충하려는 잘못된 대처",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2869800,
    "dDurationMs": 7799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "방식이 만들어내요.\n이걸 잘 이해하셔야 돼요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2874559,
    "dDurationMs": 8881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "급성 불면은 스트레스가 유발해요.\n따라서 급성 불면은 우리가 어떻게 할",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2880640,
    "dDurationMs": 7800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수가 없어요. 왜냐하면 내가 뭐\n아파서 통증이 생기거나 인간관계",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2886200,
    "dDurationMs": 9320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "갈등이 아주 심하게 생긴거나 누가 뭐\n나를 뭐 배신하고 뭐 떠나거나 뭐 뭐",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2893000,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이렇게 되는 막 사기 당하거나 막\n이런 그건 내가 어떻게 삶에서 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2897800,
    "dDurationMs": 6519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나쁜 일이 벌어지는 걸 막 사업하던\n거 부도하거나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2902000,
    "dDurationMs": 7359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어떻게 내가 할 수가 없잖아요.\n그래서 급성 불면을 유발하는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2907559,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "스트레스는 내가 어떻게 할 수가 없는\n거야. 그냥 받아들여야 돼. 할 수",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2912000,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "없어요. 근데 문제는 뭐냐면 그런\n급성 불면이 생겼다고 해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2917920,
    "dDurationMs": 9120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어떻게 잠을 좀 보충해 보고 어떻게\n좀 해 보려고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2922160,
    "dDurationMs": 8439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하다가 진짜 불면증되는 거예요.요\n인과 구조를 근데이 잘못된 대처방식",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2929480,
    "dDurationMs": 5960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이건 우리가 안 할 수 있단\n말이에요. 잘못된 대처 방식을 안",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2934119,
    "dDurationMs": 6641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하는 거 그건 우리가 컨트롤할 수\n있죠. [콧방귀] 그래서 만성 어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2938760,
    "dDurationMs": 6799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증으로는 안 갈 수 있다.이\n말이죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2942000,
    "dDurationMs": 8760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "요걸 인식하면 불면증 환자는 원인\n원인 모를 질환에 걸렸다는 무력감",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2947799,
    "dDurationMs": 7121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자책에서 벗어나서 구체적으로 교정\n가능한 행동적 표적을 확보하게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2953160,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "됩니다. 딱 행동적 표적이 뭐야? 아\n나 잘못된 대처 방식 안 할래? 이게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2956920,
    "dDurationMs": 7439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "되는 거예요. 딱 기상 시간은 딱\n고정 지킬래 이게 되는 거고 어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2962599,
    "dDurationMs": 8200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일정한 시간에 잠자리 들었다 하고\n낮잠을 안 자고 뭐 이런 그 그냥",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2967280,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "무조건 잠을 보충하려는 잘못된 대처\n방식이 아닌 거예요. 불면증으로 급성",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2973160,
    "dDurationMs": 7199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증으로 잠 못 잤어요. 잠 못\n잤어요. 그래도 제 시간에 일어나고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2978839,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "제 시간에 자야 되고 낮잠 안 자야\n돼요. 그럼 너무 피곤할 거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2982280,
    "dDurationMs": 4960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아니에요. 그럼 그날 밤 잘 잘\n확률이 올라갑니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2987440,
    "dDurationMs": 6159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "더 나쁜 건 뭘까요? 아, 너무\n불면증으로 잠 못 잤어. 그래서 오늘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2991880,
    "dDurationMs": 7160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내가 너 출근하기 너무 힘들어.\n그랬다고 해서 막 평소 마시던 거보다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 2996400,
    "dDurationMs": 8199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "훨씬 센 [목을 가다듬음] 독한 커피\n마시고 막 에너지 드린 그 카페인",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3001880,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "드는 거 마시고 이런 잘못된 대처\n방식이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3006440,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "만성 불면증으로 가는 거예요. 만성\n불면증은 병이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3012119,
    "dDurationMs": 7561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "급성 불면증은 병 아니에요. 당연한\n거예요. 스트레스 확 받으니까 잠만",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3016960,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "안 오는 거 당연한 거예요.\n급정 불면증은 내가 어떻게 할 수",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3021400,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "없어요. 근데 만병 만성 불면증은\n병이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3026200,
    "dDurationMs": 7159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "근데 그건 내가 어떻게 할 수 있다\n이거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3030280,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 완성 불면증으로\n가는 걸 막는 거. 여러분들이 거기로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3036839,
    "dDurationMs": 8161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "향해 가는 걸 막는 거. 그게이\n강의의 오늘 강의의 목적입니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3041520,
    "dDurationMs": 13200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "얼마든지 가능합니다. 자, 그러면은\n이게 침대가 각성 신호가 되는 거.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3050599,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그거를 이해를 하셔야 돼요. 뭐냐면\n이게 나쁜 습관이 드는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3057559,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐냐면\n스트레스 받아 좀 처음에 시작은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3061079,
    "dDurationMs": 4441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이렇게 됩니다. 불면증이다. 살다\n보면 스트레스 받는 일이 생기고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3064040,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "속상한 일이 생기고 뭐 어디가 아픈\n일이 생기고 뭐 사건 사고 생겨.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3067680,
    "dDurationMs": 8119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 하루 이틀 잠 못 자요.\n거기까진 좋아요. 그거 받아들이고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3073520,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그냥 가면 되는데\n그랬다고 해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3079000,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "와 김주환 교수가 잠 잘 자야 된다\n그랬어.이 잠못 자면 난 큰일 나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3083280,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거. 응. 편도체 활성화되고 면역력\n떨어지고 미터콘들이아 작살고 그 큰일",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3088079,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나. 그래서 마구 노력을 하기\n시작합니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3092920,
    "dDurationMs": 9360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "노력을 한다고요. 수면 시간\n확보하겠다는 의도로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3098880,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "졸름이 오지 않는 상태에서\n아직 각성 상태죠. 스트레스 받은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3104119,
    "dDurationMs": 6281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "상태니까.\n그래서 나 일찍 자야 돼. 그러고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3107200,
    "dDurationMs": 8760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일찍 침대 들어가 누워 버려요. 잠도\n안 오는데 누워 있는 거예요. 침대에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3113400,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "누워서. 그럼 잠이 들어요? 안\n들지. 그럼 어떻게 돼요? 몇 시간씩",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3118400,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "깨 있는 거예요. 두시간 세시간\n자려고 뒤척뒤척 하는데 두 시간 세",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3123799,
    "dDurationMs": 6361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시간 잠이 안 들어. 괴롭죠.\n괴로우면서 어떻게 돼요? 더",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3127760,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불안해지죠. 그러면서 어떻게 돼? 나\n지금 자야 되는데 못 자네.이 어떻게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3132160,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돼요? 내가 이상이 생겼나 보다. 더\n불안해져. 더 각성돼. 이러고 있는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3137079,
    "dDurationMs": 7921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요.\n건강한 수면자에게는요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3142079,
    "dDurationMs": 8121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "침대 백의 어두운 침실 조명. 요게\n딱 요런 조건이 갖춰지면 다시 말해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3147319,
    "dDurationMs": 9800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "깜깜한 밤에\n편안한 침대 다 누으면이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3153680,
    "dDurationMs": 10360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뇌 아 이제 자는 시간이구나이\n신호가 가서 이완되고 졸리고 그건",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3160520,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "조건 반응이 생겨요.\n정상 수면자는 침대라는 공간이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3167720,
    "dDurationMs": 7160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐예요? 정상 수면자한테는 침대\n누워서 자는데요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3172359,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 수면과 휴식의 경험을 계속\n연합시켰기 때문에이 뇌가 뭘 아니야?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3177240,
    "dDurationMs": 6119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어떤 습관이 돼 있어요? 아, 침대는\n자는데야. 누웠으니까 이제 자자.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3181119,
    "dDurationMs": 7801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 되는데이\n불면증 환자는 [목을 가다듬음]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3185960,
    "dDurationMs": 8280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자려고 노력을 한단 말이에요. 자려고\n애를 쓰는 거예요. 그러니까 잠은 더",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3191960,
    "dDurationMs": 6839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "안 와요. 그 침대에 누워서 하는\n일이 뭐예요? 자는 일이에요?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3196119,
    "dDurationMs": 6881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아니요. 자는 일이 아니라 자려고\n애쓰는 일이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3200760,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그까 침대는 어떤 공간이 돼 버려요?\n자꾸 자려고 애쓰는 공간. 자려고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3206799,
    "dDurationMs": 9320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "애쓰지만 잠이 안 드는 공간이 되는\n거예요. 그래서 그 시간 동안",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3212240,
    "dDurationMs": 10440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "침대에서 내일 일 걱정하고 잠들지\n못하는 상태 좌절하고 화나고 짜증나고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3219520,
    "dDurationMs": 8079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불안하고 수십번 뒤척이고 뭐 하고\n그럼 또이 생각 저 생각 떠올라서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3224839,
    "dDurationMs": 7361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "온갖 스토리텔링 일어나고 그러면 지금\n몇 시야 시계 확인해 보니까 아이고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3229880,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나 이게 또 요번에 뭐 3세시간밖에\n못 자겠네. 두 시간밖에 못 자겠네.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3234160,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러면 교감 신경게 더 흥분되고\n그리고 스스로가 바보 갖고 왜 나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3238760,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠도 못 자는 거야? 그리고 나 큰\n병 걸렸나 보다. 이거 이러고 있는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3243160,
    "dDurationMs": 7439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요.\n이런게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3246680,
    "dDurationMs": 11159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "1주 2주 얼마 동안 반복되죠. 그럼\n뇌 연합 학습 학습 습관이 됩니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3254880,
    "dDurationMs": 6280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "신경 가소성으로. 즉 뭐냐면 침대와\n침실. 그럼이 뇌게 뭐가 되는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3259960,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요?\n수면 투쟁하는 장소가 되는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3264160,
    "dDurationMs": 8199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "싸우는 장소인 거예요. 걱정하는\n장소인 거예요. 잠자려고 부들부들",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3269599,
    "dDurationMs": 7841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "떠는 장소인 거예요. 즉 침대와 침실\n환경이 수면, 이완,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3275692,
    "dDurationMs": 10867,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[목을 가다듬음]"
    }, {
      "utf8": " 편안하다 이걸\n주는게 아니라 과성, 인지적 반추,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3282559,
    "dDurationMs": 8921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불안, 수면 투쟁 이거랑 강력하게\n연합돼요. 그래서 어떻게 [콧방귀]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3288359,
    "dDurationMs": 9641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돼요? 그 불면증 환자한테는 침대랑\n침실이 자는 데가 아니에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3294079,
    "dDurationMs": 9841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가서 누으면 잠깨요. 가서 누으면\n갑자기 불안감이 더 올라와요. 그래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3300880,
    "dDurationMs": 8800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 저기 뭐야? 불면증 환자들 어\n흔히 보이는 행태가 뭐예요?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3307280,
    "dDurationMs": 6799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거실에서 소파에서 의자에서 아무\n데서나 꾸벅꾸벅 졸아요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3312079,
    "dDurationMs": 7201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아무데서나 꾸벅꾸벅 졸다가 너무\n졸려. TV 보다가도 졸고 책",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3316240,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "읽다가도 졸러 졸려 그러면 이제 아우\n이렇게이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3321480,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저기 뭐야 거실에서도 꾸벅꾸벅 졸고\n있으니",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3325520,
    "dDurationMs": 8319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "침대가 침실 가서 잠은 잠 오겠지\n웬걸 가서 눕는 순간 어떻게 돼요",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3331240,
    "dDurationMs": 9319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "바로 깨버려요\n바로 눕는 순간이 뇌는 아이고 여기",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3337000,
    "dDurationMs": 9559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "침대 아이고 이거 이거 또 큰일 났네\n심박수 상승하고 복잡한 생각들 나오고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3343760,
    "dDurationMs": 7240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠 있게 깨요.이\n이게 바로 뭐냐면 의제 문제가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3349440,
    "dDurationMs": 7359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아니에요.\n침대라는 조건 자극을 자동화된 조건",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3354920,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "반사로서\n부거감 신경 뭐 이런 거랑 좀 안정된",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3359480,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시스템이랑 연결을 시켜 놔야 되는데\n반대로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3363240,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "조건 반소서 교감신경 대네피질 각성\n스위치를 가동하는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3368359,
    "dDurationMs": 8200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "조건화된 각성 요게 딱 형성된\n거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3374240,
    "dDurationMs": 9319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서이\n만성 불면증으로 가는 분들에게 침대는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3380880,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "무서운 장소인 거예요.\n투쟁의 장소인 거예요. 불안한 장소인",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3386839,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요. 짜증나고\n잠이 안 오는 장소예.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3392520,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "딴 차라리 딴 데서 졸면 좋았고가\n거실 소파에서는 자면 잤지. 여기",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3397520,
    "dDurationMs": 10120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "와서 눕는 눕는 순간 잠 깨는 거죠.\n그게 불면적인 거예요. 자,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3403760,
    "dDurationMs": 7599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이렇게 자려고 애을수록 못 자는\n이유. 이거에 대해서도 확실하게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3409960,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "연구가 돼 있습니다. 그래서 이걸\n이해하시면 여러분 이런 쓸데없는 애음",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3416119,
    "dDurationMs": 8761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이걸 안 하실 거예요. 쓸데 없는\n정도가 아니라 진짜 나쁜 거죠. 바로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3420520,
    "dDurationMs": 10760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런 행동들, 불면증을 연구화하는\n행동들이 있어요. 이게 이제 합의인지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3427880,
    "dDurationMs": 11520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "모델에 나오고 하는 건데 한번\n하비인지 모델부터 잠깐 봅시다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3434880,
    "dDurationMs": 10159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자료구 애수록 못 자는 이유.\n그 불면증의인지 모델이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3442480,
    "dDurationMs": 7160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증 환자가 주관과 야간에 걸쳐\n불면의 자기 광화적 순환 고리에 딱",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3447920,
    "dDurationMs": 6919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "갇히는 기재예요.이 하비의인지\n모델인데 이게 뭐냐면이 순환 고리는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3451960,
    "dDurationMs": 8280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "먼저 침대에 누웠을 때나 주간의\n필요를 제크할 때 오늘 밤에도 잠들지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3457559,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "못하면 내일 업무 내일 업무 왕전히\n망쳐 나 지금 앉자면 내일 큰일 나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3462839,
    "dDurationMs": 8041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런 거예요. 그 수면 부족과 그\n파국적 결과에 대해서 반복적으로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3468520,
    "dDurationMs": 9279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "생각을 해요. 그래서 꼭 자야 돼.\n이렇게 돼요. 그래서 걱정과 반추에서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3474280,
    "dDurationMs": 7279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "출발을 해요. 침대에 누으면서 어 잠\n못 들면 어떡하지? 이렇게 되는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3479119,
    "dDurationMs": 8401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요.이이\n걱정이 즉각 편도 교감 신경계를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3484039,
    "dDurationMs": 10121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자극해서 자율신경계 각성 하이퍼\n어라우스 정서적 고통을 유발해요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3491039,
    "dDurationMs": 9280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불안과 생리적 각성이 고조되면 뇌\n현저성 네트워크 셀리언스 네트워크가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3496880,
    "dDurationMs": 9520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "위협을 탐지하기 위해 내외부의 수면\n관련 위협 단서에 주의를 좁혀",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3503440,
    "dDurationMs": 10879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "고정하는 선택적 주의 집중과\n모니터링이 가동됩니다. 그게 뭐냐하면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3510359,
    "dDurationMs": 7161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나 지금 자야 돼. 근데이 뇌는\nSN이 켜진 거예요. 현조석",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3515760,
    "dDurationMs": 5839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "네트워크.\n그래서 나 자야 돼. 근데 편도체도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3520079,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "활성화되고\n외부 위협이 느껴져요. 그러니까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3523400,
    "dDurationMs": 9959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어떻게 돼?이 뇌는 모니터링 상태.\n나를 위협하는게 뭔가?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3529680,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 심장 박동 소리가 두근두근\n들리기 시작합니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3535400,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 잠을 못 자요. 또는 신체\n긴장. 어디에 긴장이 들어간 거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3539599,
    "dDurationMs": 8401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "같아. 어디에 불편해? 내부 감각이\n자꾸 이상하게 배가 이렇게 아픈 거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3543960,
    "dDurationMs": 8800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "같고. 그 그다음에 시계바늘 소리\n엄청 크게 틀리고 그래서 아예",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3549760,
    "dDurationMs": 9279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시계바늘 없애 버려도 지금 몇인가\n자꾸 감시하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3554880,
    "dDurationMs": 8239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "주간에는 자신의 필요도 집중력 저와\n안색을 몇밀리 스캔해요. 그러니까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3561640,
    "dDurationMs": 5800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "낮에도 뭐냐면 나 얼마나 지금\n피곤하지 이걸 맨날 생각하는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3565280,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어제 잠 못 잤으니까. 그리고 오늘\n내가 집중형이 저화되나 안 돼하나?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3569480,
    "dDurationMs": 6160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나 지금이 상태가 괜찮은 거야? 계속\n스캔해요. 그리고 내 얼굴빛이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3573680,
    "dDurationMs": 6639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이상하지. 잠못 잤으니까 나 얼굴에\n뭐 날 거 같고 어 상태가 안",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3578119,
    "dDurationMs": 6841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "좋겠지. 나 피곤해 보여. 맨날 이런\n얘기 하는 거예요. 그 얘기는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3581799,
    "dDurationMs": 10081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐냐면요. 그 얘기는 뭐냐면 계속\n부정적 정보를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3587839,
    "dDurationMs": 10121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "모으는 거예요.이 뇌가 수면과 관련된\n부정적 정보, 위협 단서만을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3595640,
    "dDurationMs": 7240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "선택적으로 탐색해요. 그러니까 어떻게\n돼요? 실제보다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3600520,
    "dDurationMs": 5799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면 부족의 정도가 더 많이\n느껴져요. 더 피곤하게 느껴져요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3604960,
    "dDurationMs": 5639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그렇잖아요. 나 이거 피곤한 거\n아니야. 잠 못 잤으니까 이거 좀",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3607920,
    "dDurationMs": 9080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "괜찮대. 이게 자꾸 생각하니까 수면\n부족의 정도가 또 화장되게 느껴지고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3614920,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그다음에 기능 손상 이런 거 나\n피부도 맛이가고 말이야. 뇌 기능도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3619359,
    "dDurationMs": 5960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "맛이한 거 같고 집중력도 저화된 거\n같고 그런 거 아니야. 자꾸",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3622280,
    "dDurationMs": 10279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "생각하니까 훨씬 더 크게 과대\n평가하게 돼요. 그럼 어떻게 돼요?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3629559,
    "dDurationMs": 9161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그날 밤 더 불안해지는 거예요.\n그래서 이런 역기능적 수면 신념에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3634880,
    "dDurationMs": 9439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "기반한 안정 혜택을 안전 행동을\n채택하게 돼. 여기서 말하는 안전",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3641680,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "행동은\nsa 세이프 behav어라. 안전",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3646359,
    "dDurationMs": 7801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "행동은 뭐냐면 이게 역설이에요.이\n안전 행동 그럼 어 안전하게 하 거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3652480,
    "dDurationMs": 6392,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아니에요.\n이것 때문에 망치는 거예요. 뭘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3657160,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "망쳐요? 잠을 망치는 거예요.\n[콧방귀] 그래서 이러한 수면 신념에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3661839,
    "dDurationMs": 9081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "기반해서 나 잘 자야 돼. 그래서\n특정한 안전 행동들을 채택합니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3667680,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런 사람들이 채택하는이 안전\n행동이라는게 세이프이어라는게 이게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3673599,
    "dDurationMs": 5401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증의\n핵심 원인입니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3677559,
    "dDurationMs": 4441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "스트레스 자체가 핵심 원인이\n아니에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3682079,
    "dDurationMs": 7081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "더욱더 수면 조건을 악순화시키는게\n뭐냐? 한마디로 쓸데없는 차석을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3687480,
    "dDurationMs": 7319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런다 얘기.\n그래서 또 다른 학자들이 뭐",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3692280,
    "dDurationMs": 11079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하비라든지 이런 학자들이 해서\n연구한게 뭐냐면 이런 거예요. 뭐냐면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3699079,
    "dDurationMs": 9841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런 행동을 하면 불면증이 연구화된다\n하는 걸",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3705359,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "다중 회기 분석으로 플러스 종단 분석\n1년 동안 같은 샘플, 같은 연구",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3712319,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "대상을 동일한 연구 대상을 1년 동안\n팔로업 해 가면서 연구를 한 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3718119,
    "dDurationMs": 8801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 어떤 행동을 하나 안 하나\n잠자기 위해서 그다음에 1년 뒤에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3724000,
    "dDurationMs": 8440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증이 얼마나 생겼나 안 생겼나\n그래서 예를 들어서 지금 요즘 어떤",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3729400,
    "dDurationMs": 7919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "행동을 막 하고 있어 요즘 그러면\n근데 요즘 어떤 행동을 하고 있는데이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3734079,
    "dDurationMs": 11760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "사람이 그런 행동을 할수록 1년 뒤에\n불면증이 좋아지나 안 좋아지나 했더니",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3741799,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증을 만성화시키는 핵심은\n걱정 그 자체도 아니고 스트레스",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3747920,
    "dDurationMs": 9639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자체도 아니고\n잠 잘 자기 위해 나름대로 노력한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3754520,
    "dDurationMs": 7799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "노력들이었다. 이게 밝혀진 거예요.\n그러니까 참 잘 자려고 최선을 다해",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3760079,
    "dDurationMs": 6881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "노력을 했잖아요. 그게 바로 불면증의\n원인이 됐다는게이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3764960,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "다중 회기 종담 분석에서 딱 밝혀진\n거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3768760,
    "dDurationMs": 7519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "예를 들어요. 그 그거 그 불면증을\n만송화시키는 핵심이 뭐냐? 뭐 뭐",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3774599,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "쓸데없이 걱정하고 막 스트레스 많이\n받고 막 뭐 뭐 저기 뭐야 나쁜",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3779480,
    "dDurationMs": 7599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "사건에 많이 민감하게 반응하고 그런게\n아니라",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3785240,
    "dDurationMs": 7253,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭔가를 노력을 한 거야. 잠 잘 자기\n위해서 그런 쓸데없는 짓이죠. 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3790520,
    "dDurationMs": 7640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠시하게 잠을 잘하게\n[목을 가다듬음] 세이프하게 잘자려고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3794279,
    "dDurationMs": 11000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "노력한이 안전 행동들이\n그게 걱정 자체보다도 더 1년 뒤",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3801839,
    "dDurationMs": 7841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증을 예측하는 예측 변인이었다.\n이게이 연구의 결과인 거예요. 그러면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3808000,
    "dDurationMs": 8880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어떤게 쓸데없는 뜻이냐? 이런\n거예요. 누워 가지고 계속 시계",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3813079,
    "dDurationMs": 8601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "스마트폰 시간 확인하고 수면 가능\n시간 계속 계산합니다. 여러분 이거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3819760,
    "dDurationMs": 5760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "절대 하지 마세요.\n야 지금 잠들면 내가 몇 시간 잘 수",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3823200,
    "dDurationMs": 5879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있지? 내 몇 시에 일어나니까 좀 한\n한 30분 한 시간 있다가 지금 몇",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3827240,
    "dDurationMs": 5559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시지? 아이고 이제 잠들면 내가 몇\n시간 자겠네. 아유 큰일났네.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3830279,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "5시간밖에 못 잤네. 또 좀 있다가\n지금 몇 시지? 아휴이 큰일 났네.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3835160,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이제 네시간밖에 못 자겠네. 이거\n하는 거예요. 이거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3839279,
    "dDurationMs": 9601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시계 보지 마세요. 주무실 때 그냥\n잠 안 안 오면 안 오는 대로 그냥",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3844799,
    "dDurationMs": 10520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "누워 계세요. 시계 보지 마세요.\n한 며칠 잠 하나도 못 자도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3852279,
    "dDurationMs": 8921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "괜찮아요. 물론 건강 안 좋아지겠죠.\n근데 만성 불면증으로 가는 거 그건",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3858680,
    "dDurationMs": 7679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "괜찮지 않아요.\n하루 이틀 뭐 며칠 잠 못 자 가지고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3863520,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "건강 좀 나빠졌다. 하지만 그건\n회복돼요. 잠 제대로 자면 걱정하지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3869319,
    "dDurationMs": 5921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "마세요.\n이런 이런 쓸데없는 짓 하지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3872599,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "마시라고요. 두 번째는 뭐냐면 사고\n억제 및 생각하지 말자. 강박적 임면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3878240,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시도죠. 생각하지 말자. 누워 가지고\n계속 아 걱정하지 말자. 생각하지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3882200,
    "dDurationMs": 6599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "말자. 아 난 지금 자야 돼요.\n어떡하지 말. 잠이 안 오지 막 이거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3885319,
    "dDurationMs": 8921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거 하는 거 그거 하다 보면 온갖\n부정적 생각나고 가슴 두근거리고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3891279,
    "dDurationMs": 10401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이렇게 되죠. 그거 하면 안 돼요.\n그다음에 부족한 수명 보충 한 답시고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3898720,
    "dDurationMs": 8800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일찍감치 원래 수면 시간도 아닌데\n원래 막 12시에 자는 사람이 막",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3904640,
    "dDurationMs": 9639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "8시 9시에 막 자기 자려고 누워.\n어 일찍 자려고 그거 안 좋아요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3912079,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "초전녁에 좀 졸린 거 같아. 그래도\n눕지 마세요. 원래 자는 시간 뭐",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3917359,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "10시든 11시든 12시든 원래 자는\n시간에 정해 놓고 누으세요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3923200,
    "dDurationMs": 8159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "기상 시각 이후에도 아 오늘 늦게\n가도 돼 뭐 이래서 그러지 말고 잠",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3928160,
    "dDurationMs": 7959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "깨죠. 잠 깼는데 10분 20분 다시\n잠이 안 들어 그럼 그냥 일어나세요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3934680,
    "dDurationMs": 6800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "새벽 4시인데 그래도 그냥\n일어나세요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3938279,
    "dDurationMs": 7961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "새벽 4시데 눈 떠져서 난 더 자야\n돼.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3942920,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 괴로워하면서 뒤척뒤척하면서\n야 4시이 잠 또 못 자면 어떡하지?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3947960,
    "dDurationMs": 7599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "또 못 자면 어떡하지? 이러면서 6시\n7시까지 두어 시간 계속 침대 누워",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3952760,
    "dDurationMs": 7799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가지고 딩글딩글 뒹글딩글 못 자고\n괴로워하고 있다. 그게 안 좋은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3957920,
    "dDurationMs": 6879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요. 그게 침대 누워서 딩글딩글\n뒹글딩글 자려고 노력 자르고 노력",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3962359,
    "dDurationMs": 8200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뒹글딩글 그러면 뇌 어떤 여어\n어소세이션 연상이 생기겠어요. 침대는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3967799,
    "dDurationMs": 8721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "누워서 괴로워하는 곳. 침대는 누워\n있어도 잠이 안 드는 곳이라는 걸",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3974000,
    "dDurationMs": 6920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뇌에 자꾸 심어 주는 거예요. 그러지\n마세요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3978079,
    "dDurationMs": 6720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "새벽에 깼어요. 10분 20분 잠이\n안 들어요. 한 10분 20분을 다시",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3983000,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자려고 노력해 보세요. 그냥 누워서\n계세요. 근데 10분 20분데도 잠이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3987200,
    "dDurationMs": 5480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "점점 안 들어고 깨는 거 같아요.\n그럼 그냥 일어나세요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3990440,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "두 시간밖에 못 자는데\n두 시간밖에 못 주으셨어도 다시 잠들",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 3995039,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가능성이 없으니까 일어나서 침대\n밖으로 나와야 돼요. 거실에 계시던",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4000319,
    "dDurationMs": 8520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "딴데 계셔야 돼요. 그래서 침대는\n자는 곳,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4005119,
    "dDurationMs": 9041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "침대 바깥은 안 자는 곳. 이걸 딱\n뇌에 알려 줘야 돼요. 신경 가소",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4011240,
    "dDurationMs": 8079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그렇게 훈련시켜 줘야 돼요. 그다음에\n한 잔 하면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4016200,
    "dDurationMs": 9680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠 잘 오겠지. 아니, 아직도\n알콜, 술 먹는게 잠에 도움이 된다고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4022119,
    "dDurationMs": 8561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "생각하시는 분 혹시 계세요? 알코올\n또 다른 각성제예요.이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4028119,
    "dDurationMs": 7561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "카페인하고 작동 방식이 틀려서 그\n달라서 그렇지. 알코은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4033839,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "각성적이니까 밤새 술 마실 수 있는\n거예요. 잠만자고.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4037760,
    "dDurationMs": 5960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "알코은\n수면 방해해요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4041880,
    "dDurationMs": 7959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 많이 취해 갖고 그냥 골라\n떨어져서 뭐 자는둥 마는둥 그때 자는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4046240,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거 정말 수면 퀄리티 엉망이고요.\n술이 깰 때쯤 잠도 깨요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4053160,
    "dDurationMs": 9520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 많은 경험이 있으실 거예요.\n술 먹고 잠 드시면 술 깰 때쯤",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4058760,
    "dDurationMs": 7839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "새벽에 잠도 깨어 잠을 설치요.\n절대",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4064319,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "술 취한 상태에서\n주무시지 마세요. 술을 꼭 드셔야",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4069200,
    "dDurationMs": 8200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "되면\n낮에 드세요. 낮에 아예 낮을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4072680,
    "dDurationMs": 11080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "드세요. 낮에 술 드시고 밤에는 술대\n깬 다음에 잠자리에 드는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4081319,
    "dDurationMs": 7361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "술이 다 깬 다음에\n잠에 잠자기 시작한다. 이걸 잊지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4085680,
    "dDurationMs": 9359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "마세요. 되도록이면 저녁 때 그러니까\n술 드시마세요. 술은 낮에 술은 낮에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4091920,
    "dDurationMs": 7879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "먹는 거지 예. 밤에 먹는게 아니다.\n이렇게 알아두시는게 좋아요. 아니,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4097359,
    "dDurationMs": 7641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "낮에 직장 생활에 있고 낮에 술 못\n먹대 그건 못 드시는 거죠. 못",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4102120,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "드시는 거고 저녁에는 술을 먹으면 안\n되니까. 왜냐면 밤에 자야 되는데.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4107080,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러니까 그러면 낮에도 못 먹고\n밤에도 못 먹나? 아, 그러면 주말",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4111040,
    "dDurationMs": 6719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "주말 낮에 드세요. 주말 낮에. 예.\n직장에 안 가시고 그럴 때 꼭 그렇게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4115279,
    "dDurationMs": 8440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "술을 드시고 싶으면 아 주말에\n아침부터 드세요. 그 아침부터",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4120319,
    "dDurationMs": 7761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "점심까지 드시고 그다음에 술 깨기를\n기다려서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4125880,
    "dDurationMs": 9080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "밤에 주무세요.\n낮에는 커피 고농도 섭취 금지 금해야",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4131560,
    "dDurationMs": 8639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돼요. 이거 이거 이거 어 낮에 커피\n마시고 밤에 술 드시고 이러면은 이거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4137440,
    "dDurationMs": 8359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "완전히 안 되는 거예요. 그다음에\n이것도 중요해요. 수면 부족을 이유로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4142759,
    "dDurationMs": 7361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내가 급성 응 그 불면증으로 수면\n잠을 잘 못 잤어. 그렇다고 운동도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4147799,
    "dDurationMs": 7960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "안 해. 사회 생활도 안 해. 이게\n축소해. 그리고 자꾸 방에 가만히",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4151799,
    "dDurationMs": 3960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있으려고 그래. 그럼 잠면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4155799,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "부족이 생겼어요. 굉장히 큰\n스트레스로.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4159960,
    "dDurationMs": 9600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래도 일상생활 똑같이 해야 그래야\n다시 원래 상태로 빨리 돌아갑니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4167157,
    "dDurationMs": 7042,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[콧방귀]"
    }, {
      "utf8": " 그리고 계속 스스로의\n컨디션 체크하고 이거 하면 안 돼요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4172440,
    "dDurationMs": 5799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내가 잠 못 잤는데 나 괜찮나? 나\n어디 아픈 거 아닌가? 잠 못 잤는데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4175920,
    "dDurationMs": 6359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나 어디 아프지 않나? 괜찮나? 아\n나 자꾸 얼굴 거울 들여다 보면서 나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4180239,
    "dDurationMs": 8920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "얼굴 괜찮나? 이런 거 하면 안\n돼요. 그러면 점점 더 안 괜찮은게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4185799,
    "dDurationMs": 8081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "보일 거예요. 그런 거 하지 마시고\n틈만나면 낮잠 자거나 눈 감고 수면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4191759,
    "dDurationMs": 12960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "부족이니까 이거 자꾸 틈만 낮잠\n자려고 이것도 하지 마세요. 예.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4199199,
    "dDurationMs": 8520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그렇게에 하셔야 됩니다. 예. 자,\n그다음에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4209880,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 그래서 한마디로 뭐냐? 자려고\n노력하지 말라 이거야. 자려고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4213560,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "노력하지 말라.이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4217239,
    "dDurationMs": 12041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런 실제로 어 연구도 있어요. 자고\n노력하면 안 돼. 잠은 자동적이고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4226640,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아 잠깐만요. 술을 드시려면 낮에\n드세요. 이랬으니까 아 김주환 교수가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4231199,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "낮 먹으래. 아니, 저는 술을 드시지\n말라고 하는 거예요. 술은 백해",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4236920,
    "dDurationMs": 5759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "무익합니다. 진짜 알콜은 백해\n무익해요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4241320,
    "dDurationMs": 5680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐 한 잔 먹으면 더 오래 산다.\n그런 거 다 거짓말이었음이 밝혀졌고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4244760,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "술은 무조건 건강에 안 좋습니다.\n그래서 술을 드시지 않는데 그래도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4249960,
    "dDurationMs": 9600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나는 꼭 술을 먹하겠다 하시는 분이\n있으면 꼭 드셔야 되겠으면 수면에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4256520,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "방해가 되지 않도록 낮에 드셔라\n하는게에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4262400,
    "dDurationMs": 8600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "제 뜻입니다.\n자, 잠은 자동적이고 불수위적인",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4267400,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가정이에 요걸 이해하셔야 돼요.\n잠은 잘 자는 사람은요. 잠에 대해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4273360,
    "dDurationMs": 7640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "생각을 안 해요.\n잘 걱정을 안 한다고요. 그냥",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4278719,
    "dDurationMs": 8401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "걷는거나 숨쉬처럼 저절로 되는\n거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4283880,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면은 자동 과정이에요.\n우리 숨 쉴 때 저절로 숨",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4288880,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "쉬어지잖아요. 심장 박동 저절로 뭐\n심장아 뛰어라 뛰어라 안 해도 저절로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4294440,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뛰어지잖아요.\n이렇게 해야 돼요. 그래서 잠드는 건",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4299880,
    "dDurationMs": 10160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저절로 일어나는 일이다.\n내버려 두면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4305000,
    "dDurationMs": 11760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저절로 잠든다. 또는 내버려 둘수록\n그냥 놔둘수록",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4312800,
    "dDurationMs": 9240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그냥 다 받아들이고 수용할수록\n잠을 더 잘 잔다. 이런 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4320400,
    "dDurationMs": 8200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 [콧방귀]\n먼저 잠에 어텐션을 주는 거 있죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4325120,
    "dDurationMs": 8280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나이 내 내가 지금 잠 얼마 잤지?\n나 몇 시간 잤지? 아 나 너무 졸린",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4331400,
    "dDurationMs": 6799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거 아니야? 어, 나이 잠 잘 못\n자고 있는데. 잠에 어텐션을 많이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4335560,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "줘요. 그다음에\n나 자야 돼. 나 자야 돼. 강력한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4341120,
    "dDurationMs": 6920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "인텐션 생겨요.\n그러니까 자려니까 이런저런 노력을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4346840,
    "dDurationMs": 7560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "해.\n잠에 대한 어텐션, 잠에 대한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4350360,
    "dDurationMs": 8960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "인텐션, 잠에 대한 다 불면증으로\n가는 길이에요. 이게 수면을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4356880,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "망가뜨리는 거예요.\n잠에 대해서 치다치게 예민하게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4361320,
    "dDurationMs": 8879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "생각하고 자야지 자야지 생각하고\n자르고 자르고 노력하면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4367120,
    "dDurationMs": 7039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠을 망친다 하는 거예요. 호흡 한번\n호흡을 한번 생각해 보세요. 호흡의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4372280,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어텐션 그다음에 내버려두죠. 그게\n아니라 호흡에 어텐션 한다에 어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4376480,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "호흡을 [콧방귀] 어떻게 아름답게\n내가 잘 줄 수 있을까? 호흡을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4379679,
    "dDurationMs": 6721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어떻게 길게\n[한숨] 이렇게 할 수 있을까? 호흡",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4383960,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "조절하는 거죠. 그다음에 호흡을\n잘하기 위해서 매마다 들여실 때마다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4389280,
    "dDurationMs": 7879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "최선을 다해 들여시고 내쉴 때마다\n최선을 다해 내셔. 그럼 호흡이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4393080,
    "dDurationMs": 10960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어떻게 돼요? 엉망 진창이 되죠.\n호흡은 그냥 내버려 두는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4400040,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "호흡 명상은 그냥 내버려던 호흡이\n어떻게 되나를 그냥 알아차리기만",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4406236,
    "dDurationMs": 5244,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[콧방귀]"
    }, {
      "utf8": "\n하는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4409040,
    "dDurationMs": 6119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그게 아니라 호흡을 막 내가 의도를\n갖고 조절하고 호흡을 막 열심히",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4413360,
    "dDurationMs": 8440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하려고 갈수록 호흡은 망가져요.\n그것처럼 잠도 잠을 자려고 막 열심을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4418760,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "다해서 최선을 노력하죠. 그러면 잠을\n망가뜨립니다. 그게 불면증으로 가는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4423920,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "길이에요.\n겉길을 한 걸음씩 의식하면 걸음도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4428320,
    "dDurationMs": 6839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어색해지죠. 그냥 저절로 자연스럽게\n걸으면 돼요. 자려는 노력은 잠을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4433520,
    "dDurationMs": 10320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "망가뜨립니다.\n그래서이 SB이 연구팀은 아예 수면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4438800,
    "dDurationMs": 10120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "노력 당신 잠고 얼마나 노력하세요라는\n그런 그 수면 노력을 재는 검사",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4446080,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "척도까지 만들었어요. 그 여기 있는\n거 이런 거죠. 어, 수면 시간",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4450679,
    "dDurationMs": 8281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "확인한다. 아, 수면을 자야 돼.\n지금 자야 돼라고 생각한다. 초전녁에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4455239,
    "dDurationMs": 8361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "미리 눕는다. 뭐 등등\n이렇게 수면을 위해서 당신이 무슨",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4460719,
    "dDurationMs": 8641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "노력을 하고 있습하고 있습니까? 그때\n난 이런 노력도 하고 저런 노력도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4465080,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하고 수면 노력을 많이 하죠.\n연구 결과 딱 나온 거예요. 수면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4471679,
    "dDurationMs": 7801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "노력을 많이 하죠.\n불면의 심각도예요. 바로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4477280,
    "dDurationMs": 6840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면 노력을 많이 하는 사람이 불면증\n환자예요. 근데 여기서 인과 관계가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4482159,
    "dDurationMs": 6601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "불면증이니까 수면 노력하지\n아니라니까요. 지금 제가 여태까지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4486360,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "말씀드린 건 수면 노력을 쓸데없이\n해서 불면증 생긴 거라이 말씀이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4490840,
    "dDurationMs": 9839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 그런 거 하지 마시란 얘기예요.\n프랭클은 불면의 원인을 과잉 의도로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4497520,
    "dDurationMs": 10159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "보도의 과잉. 하이퍼인텐션\n자야지. 난 꼭 자야 돼.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4504719,
    "dDurationMs": 6920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "오늘 자고야 말겠어. 오늘은 반드시\n푹 자야 돼.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4509360,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그럼 망하는 거예요.\n자녀는 의도가 지나치면 잠이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4514639,
    "dDurationMs": 10441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "달아납니다.\n사실 모든게 그래요. 모든게 지나치면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4522679,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "다 망가져요.\n성공하려는 의도가 지나치면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4527880,
    "dDurationMs": 7720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "망가져요.\n뭘 잘해 보려는 의도가 지나치면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4532760,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그것도 망가져요.\n제일 좋은 건",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4537880,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지금 이대로\n있는 그대로예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4541760,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 장자가 얘기한게 뭐예요? 무\n자연",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4546679,
    "dDurationMs": 7841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있는 그대로 놔둔다 하는 거예요.\n무위 자연은 doing",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4552400,
    "dDurationMs": 5360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "nothing이 아니에요. doing\nwithout",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4555040,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "intention이에요.\n모든 것을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4560320,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "언던\n하지 않는 거로 놔두지 않는 상태.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4564320,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그니까 모든 걸 다 해내요.\n근데 뭐로? without인",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4568400,
    "dDurationMs": 7759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "inten션 의도하지. 그게 무의\n자연이에요. 무의 자연은 아무것도 안",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4573719,
    "dDurationMs": 8713,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하고 가만히 앉아 있는게 아니라\n어떠한 의도도 없이 모든 걸",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4579440,
    "dDurationMs": 6199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "다해내는게 무의자연이에요.\n[콧방귀]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4583040,
    "dDurationMs": 8520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠 잠이야말로 그래요. 잠이야말로\n우리에게 찾아오는 거예요. 잠이야말로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4588520,
    "dDurationMs": 8520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나에게 찾아오는 거예요. 잠이야말로\n내 의도 넘어서 있는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4597239,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "더 이상 뭘 의도하지 않으려는\n우리 뇌 몸의 상태가 잠자는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4604239,
    "dDurationMs": 11920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런데 자꾸 의도하면 잠이 깨져.\n불면증이 오죠. 그러니까 어텐션",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4611040,
    "dDurationMs": 8360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "인텐션 둘 다 내려놓는 걸 합니다.\n프랭클은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4617679,
    "dDurationMs": 4841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "과잉 의도가 불면의 원인이다\n그랬어요. 그래서 자련 의도가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4620639,
    "dDurationMs": 10321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지났지만 잠이 다나요? 그래서\n환자한테 아예 반대로 시켰어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4627880,
    "dDurationMs": 7759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가능한한 오래 깨어 있어 보세요.\n자, 오늘 밤 자지 말고 한번 오래",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4632840,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "깨어 있어 보세요. 그랬더니\n다들 더 빨리 잠들었어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4638760,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어, 자려고 노력하면 못 자고요.\n깨으려고 노력하면 졸려요. 여러분",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4643760,
    "dDurationMs": 5680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그거 알잖아요. 우리 다\n경험했잖아요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4647320,
    "dDurationMs": 7399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "깨 있으려고 노력하면 졸려요. 야,\n시험 때야. 오늘 밤새야 돼. 얼마나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4651800,
    "dDurationMs": 9600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "졸려요? 다 알죠. 여기 나오는\n거예요. 왜 너무나 당연한 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4657760,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자려고 노력하면 안 안 잠들고요.\n오늘 밤 나 자면 안 돼. 오늘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4663520,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "말이야 나 밤새야 돼. 내일 시험인데\n시험 공부 하나도 안 했어. 무지하게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4667920,
    "dDurationMs": 6160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "졸려요. 경험 없으세요? 다 있을\n걸. 다 있을 거예요. 그게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4672320,
    "dDurationMs": 5960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거예요.\n그러면 그거 사용하세요. 어떻게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4676480,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "사용해요?\n앉으려고 해 보세요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4681000,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그리고 안려는 의도까지도 내려 내려\n놓으세요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4685080,
    "dDurationMs": 8280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "의도를 내려놔야 돼요. 인텐션\n자려는 의도를 내려놔야 돼요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4691400,
    "dDurationMs": 9160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "놀랍게도 이것조차 실험을 해\n봤습니다. 불면증 환자한테 어두운",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4696679,
    "dDurationMs": 8201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "방에서 눈 뜨고 잠자지 마세요. 어,\n울면증 앉잔 뉘어 놓고 어둠 빨리",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4702920,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "주무세요가 아니라 자 지금부터 할\n일은 잠을 안 주무시는 겁니다. 어둠",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4708840,
    "dDurationMs": 8879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "방에\n누으셔 가지고 눈 감지도 마시고요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4714719,
    "dDurationMs": 7041,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가능한 하나한 오래 깨어 있으세요.\n그랬더니",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4719920,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠들려고 하지 마, 자지 마라는\n지시를 내렸더니 그 지시를 받은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4724120,
    "dDurationMs": 7640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "집단이 다 더 빨리 잠들었어요. 이게\n실제로 있는 일이에요. 실제로 실험",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4729000,
    "dDurationMs": 6840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "결과 나온 거예요. 또 반대 방향\n실험했어요. 뭐 뭐라 그럴까요?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4733840,
    "dDurationMs": 6839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "최대한 빨리 잠들려고 지시해 봤어요.\n그리고 막 행진국도 틀어줘서 부활을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4737600,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "줬어요. 그랬더니 지시받 받 받지\n않는 집단보다 잠드는데 더 오래",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4742520,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그랬어요. 그냥 놔뒀어요. 그냥 놔둔\n집단이 더 빨리 잠들었어요. 뭐보다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4747960,
    "dDurationMs": 7320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "빨리 잠드세요라는 지시를 내린\n거보다. 즉 빨리 잠들어라 하는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4751719,
    "dDurationMs": 7201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "의도를 주면 잠앉아요. 거꾸로 아까\n위에 거는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4757360,
    "dDurationMs": 5855,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠들면 안 돼요. 그럼 다\n잠들었어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4760594,
    "dDurationMs": 7246,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[콧방귀]"
    }, {
      "utf8": " 이게 역설적 과정이라는\n[목을 가다듬음] 거예요. 생각을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4765280,
    "dDurationMs": 7439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "통제하려는 시도는 그 생각을 감시하는\n과정을 함께 가동하고 자원이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4770000,
    "dDurationMs": 10400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "부족해지면 감시 과정만이 남아서\n통제하려던 것이 오히려 더 강해져요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4776600,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "또 세 번째 실험도 있어요. 침대의\n생각을 직접 다루었어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4783159,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 자 이요 요요번에 지시 사항은\n뭐냐면 자 누워서 주무실 때 떠오르는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4788239,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "생각을 억눌러라.\n생각이 떠오르면 그거 하지 않으려고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4793320,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "노력해라.\n요런 지시를 받은 사람들은 더 오래",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4798000,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "걸렸어요. 수면의 질도 나빴어요.\n그냥 잠자리에서 떠오르는 생각이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4802639,
    "dDurationMs": 8161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있으면 그 생각을 그냥 알아차리고\n그냥 바라보면 돼요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4809080,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "누워서 주무시려고 그러는데 온갖\n잡생각이 떠올라 그러면 아우 나이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4812560,
    "dDurationMs": 7720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잡생각 떠올라. 이거 또 이러네.\n그러고 막 그걸 눌러하지 말고 잡생각",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4816440,
    "dDurationMs": 9199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "떠오르죠. 그러면 그걸 그대로 따뜻한\n마음으로 알아차리면 돼요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4823480,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그게 더 나아요. 그게 더 수면에\n도움이 된다는 얘기. 실제로 싫어해",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4827520,
    "dDurationMs": 8159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "보니까 생각 억누르라고 지시받은\n집단이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4832239,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠드는데도 오래 걸렸고 수면의 질도\n나빴다 말이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4837719,
    "dDurationMs": 7161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "억제는 실패해요.\n그러면 뭐가 성공하는가?이 생각을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4843360,
    "dDurationMs": 4040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "누른다. 생각 같은 거 누르는 그런\n억제는 실패한다. 그 뭐가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4846120,
    "dDurationMs": 8039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "성공하는가?\n생각을 억누르는 대신 편안하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4851960,
    "dDurationMs": 9520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "흥미로운 장면을 떠올리게 했어요.\n생각 억누르지 말고 뭔가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4857400,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "심상 주의 분사예요. 어떤 좋은음\n사건을 떠올리고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4863800,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어텐션을 거기에다 줘 봐. 이랬더니\n어 잠이 더 빨리 들어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4870480,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그냥 아무 방법으로나 그냥 딴 생 딴\n생각해. 주의를 돌려라고만 한 일반",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4876920,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "주의분산 집단은 효과가 없었는데\n심상주의 분단은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4881440,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "효과가 있었다. 그다음에 또 한 가지\n중요한 거 양세는 거 있죠. 뭐",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4886400,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "서양에 주로 있죠. 양 한 마리, 양\n두 마리, 뭐 양이 이렇게 뭘 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4890239,
    "dDurationMs": 6201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거 난간을 넘어가는 거 이거 하나\n양 두 마리, 양 세 마리 그런",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4894320,
    "dDurationMs": 8720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "단조로운 과제는\n마음을 충분히 차지하지 못해서 즉",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4899400,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "우리의 어텐션 하는이 전전 두피질의\n그 기능을 충분히 차지하지 못해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4906080,
    "dDurationMs": 5280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "너무 쉬우니까 양 한 마리, 양두\n마리 그 양 한 마리 양두 마리",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4909400,
    "dDurationMs": 7160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하면서 다시 걱정을 하는 거예요.\n왜냐면이 뇌 기능이 이렇게 여유가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4914239,
    "dDurationMs": 9281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있으니까.\n그래서 대체를 해야 돼요. 다시",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4919480,
    "dDurationMs": 8320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "말해서 뭐냐면이 심상주의 문산처럼\n내 어텐션을 내 생각자고 생각이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4926080,
    "dDurationMs": 6159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "여기저기 막 잠이 왜 안 오지? 여러\n가지 온갖 생각이 나는데 생각 눌러라",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4930400,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러면 안 되는 거예요. 지금 여기\n보는 거 같이. 그러지 말고 생각을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4935000,
    "dDurationMs": 9652,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하고 또는 어텐션을 하고 어텐션을\n없애세요. 잠에 대한 어텐션 말고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4941400,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "딴데 어텐션 보내면 되는 거예요.\n[콧방귀] 그 대체물 그 어텐션의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4946520,
    "dDurationMs": 8159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "대상이 되는 건 뭐냐? 내 마음을\n적당히 채울만큼",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4951320,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "흥미롭고 감정적이고 중립적이면\n좋다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4956400,
    "dDurationMs": 5400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거죠.\n여기서이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4962080,
    "dDurationMs": 9760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠잘 잘잘 때 보낼 어텐션의 대상으로\n많은 연구가 됐고 많은 사람들이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4969480,
    "dDurationMs": 7560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "효과를 보고 한게 뭐냐? 바로\n음악입니다. 음악. 근데 음악도 아무",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4974440,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "음악이나 되는게 아니라 진짜 효과적인\n음악이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4978560,
    "dDurationMs": 8159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있는 겁니다. 자\n그러면 왜 음악이 우리 저기 뭐야?이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4984440,
    "dDurationMs": 9320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이 그 불면에\n불면증을 완화시켜 주나 그 메커니즘도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4990679,
    "dDurationMs": 8241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "알아야 되죠. 음악이 왜 잠자는데\n도움이 되는가 하면 그냥 음악 들으면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 4996840,
    "dDurationMs": 9399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "편안하니까 이거 아니에요. 딱 그\n이유가 딱 있어요. 첫째는 뭐냐면요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5002400,
    "dDurationMs": 10520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "음악이 과성을 완화시키는 그게 뭐냐면\n청각 뇌관 자율신경계 동조화",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5009719,
    "dDurationMs": 8081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "현상이에요. 청각 신경로는 대네피질에\n도달하기 전에 대네피질의 의식이 있는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5014840,
    "dDurationMs": 8760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요. 뇌간의 달팽이액 뭐 사항\n올리브 복합체 하구및 망상체를 경우",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5020840,
    "dDurationMs": 9120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "미주신경 복합체랑 직접 상호\n자원합니다. 미주신경이 활성화돼야",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5026360,
    "dDurationMs": 9680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이완이 됩니다. 그리고 분당 60에서\n80박자 정도가 일상적인",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5033920,
    "dDurationMs": 9239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "심장 박동이랑 좀 비슷한 거예요.\n안정적 템포와 예측 가능한 주기성.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5039719,
    "dDurationMs": 8920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 예측 가능성이 또 중요해요.\n왜냐면 우리 뇌는 예측 오류를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5046159,
    "dDurationMs": 8441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수정하려고 하거든요. 그 저기 뭐야?\n능동적 출론 이론. 예. 내면 소통",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5050600,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "5장. 예측의 오류에 포커싱이 돼\n있어요. 그래서 예측 오류가 자꾸",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5056360,
    "dDurationMs": 8600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "생기잖아요. 그 각성이 일어나요.\n근데 모든게 예측 가능하단 말이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5063199,
    "dDurationMs": 7641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "음악이 예측 가능해. 왜냐면 음악은\n뭐네 박자, 세 박자 일정한 박자",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5067639,
    "dDurationMs": 11881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지내고 이렇게 반복이 되고 그래서\n뇌에게 약간 변화를 줘서 어텐션을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5074159,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가져가면서도 동시에 예측 가능한 그런\n자극물이 되는 거예요. 그래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5081548,
    "dDurationMs": 5532,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e [콧방귀]",
      "isSpeakerChange": 1
    }, {
      "utf8": "\n\u003e\u003e 뇌간의 심패 조절 중추 같은 걸 즉각",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5084600,
    "dDurationMs": 9599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "동조화시켜 교감 신경 흥분을\n낮춥니다. 미주신경은 활성화시킵니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5091000,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 첫 번째 메커니즘이에요.\n두 번째는 뭐냐면 변현계",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5097360,
    "dDurationMs": 10359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "림픽 시스템 저 편도체 포함한 여기서\n보면 조화롭고 평온한 음악은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5104400,
    "dDurationMs": 9480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "우리가 늘 얘기하는 MPFC와\n전 대상 피질 ACC 안테리어 싱귤",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5110199,
    "dDurationMs": 13361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "코텍스를 활성화하는 동시에 공포와\n경보를 담당하는 아믹달러 편도체를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5118600,
    "dDurationMs": 10840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하향 조절한다. 이거예요. 그래서\n뭐냐면이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5125679,
    "dDurationMs": 9560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "음악을 편안하게 리드미컬하게 요걸\n들으면 실제로 MPFC 활성화되고요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5133159,
    "dDurationMs": 5761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "편도체 다시 말해서 편한 전할이\n일어난다는 연구예요. 연구 결과를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5137199,
    "dDurationMs": 9801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요.\n세 번째는 신경 내분비계 조절로서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5142480,
    "dDurationMs": 9600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "취침전 음악 감상은 불면증 환자에게\n야간의 상승에 있는 불면증 환자는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5149119,
    "dDurationMs": 9801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "야간의 HP 축이 막 그 활성화돼\n있다 그랬잖아요. 그거를 쫙",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5155080,
    "dDurationMs": 9119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "감소시킵니다. HPA 축상에 그 하\n호르몬들의 분비를 쫙 감소시켜요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5162280,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "또 한 가지는\n인지적 주의 제조정 및 디폴트 모드",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5167679,
    "dDurationMs": 8721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "네트워크 억제 경로가 활성화됩니다.\n즉 구조화된 음악 자극이 또 예측",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5173400,
    "dDurationMs": 10839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가능한 음악 자극이죠. 청각 피질과\n작업 기억의 주의 자원을 점유함으로써",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5181000,
    "dDurationMs": 8840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자기 참조적 걱정과 반출을 생성하는\n디폴트 모드 네트워크의 과잉 활성을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5187199,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "차단합니다. 이게 무슨 얘기냐면\n구조화된 음악 자극을 들어야",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5191679,
    "dDurationMs": 7921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "되잖아요. 그럼 거기서 어텐션을 뺏어\n가고 워킹 메모리에 그 워킹 메모리는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5197440,
    "dDurationMs": 9600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "한정돼 있어요. 그 워킹 메모리 그\n일하는 그 기능을 뺏어 가니까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5203679,
    "dDurationMs": 7601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "쓸데없는 딴 생각이 일어날\n그럴 여유가 없는 거예요. 여기서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5209280,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "말은 자기 참조적인 거. 셀프\n리퍼런셜 이게 평소 자기 참조 뭐",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5214239,
    "dDurationMs": 9480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "명상하면 이게 좋은 거지만 전전도\n빛이 활성화되지만 일반적으로 주무실",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5220360,
    "dDurationMs": 7879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "때 자기 참조적 이걸 하면 셀프 자꾸\n어 돌이켜 보고 부정적인 거 들어와서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5225960,
    "dDurationMs": 10279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "반추하고 그러면\n활성화 아 그 각성이 일어납니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5231040,
    "dDurationMs": 9599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 각성이 일어날 만한 그런 뇌의\n여유분을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5238040,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런 뭐는 왜 이래 무슨 생각하고\n내일 어떡하지 뭐 이렇하고 막 이런",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5243480,
    "dDurationMs": 7715,
    "wWinId": 1,
    "segs": [ {
      "utf8": "스토리텔링\n할 그런 리소스를 빼가는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5249000,
    "dDurationMs": 6639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐가 음악이 구조화된 음악이\n[목을 가다듬음] 빼가는 거죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5252960,
    "dDurationMs": 9320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러면은 여기서 이게 아 음악을\n들으면 이러한 그 어 역할 때문에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5259679,
    "dDurationMs": 6401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "릴렉스되고 잠이 들겠구나 하는데\n거기서 한 걸음 더 나가서 그냥 아무",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5264600,
    "dDurationMs": 7240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "음악이나 아닙니다. 뭐 조용하고 뭐\n이런 거 아니에요. 뭐냐? 저의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5272040,
    "dDurationMs": 10040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "비장의 무기. 비장의 무기. 저의\n왜냐면 저는 20대 때부터 잠이 좀",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5279280,
    "dDurationMs": 9919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잘 안 오고 이럴 때는 늘 바하의\n평균율 어 골드 베르그 베리에이션",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5285119,
    "dDurationMs": 8161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "등등을 들었습니다. 그래서 마하음악이\n졸리다는 걸 저는 체험으로 알고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5291040,
    "dDurationMs": 9599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있는데\n실제로 비슷한 연구들이이 근거가 되는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5296679,
    "dDurationMs": 8281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아 이래서 바연 바음악이 졸립구나\n이거를 알 수 있는 겁니다. 근거가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5303400,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있는 겁니다. 왜 바하고 왜\n평균율이냐? 자, 보면 실제로 잠 잘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5309040,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "때 무슨 음악 많이 드세요? 잠에\n도움이 되는 음악이 뭐예요라고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5314560,
    "dDurationMs": 7559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저기 그 여론 조사를 해 본 거예요.\n1등이 바하였어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5319800,
    "dDurationMs": 7200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "예. 바는 졸린 사람이 아저\n죄송합니다. 바하가 졸린 사람이라는게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5323840,
    "dDurationMs": 8279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아니라 그 음악을 들으면 졸린게\n맞아요. 아, 무슨 클래식 음악을들을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5330159,
    "dDurationMs": 8241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "때 졸리면은 뭐 창피하다 이런\n생각하시는 분 있을지 모르는데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5335400,
    "dDurationMs": 7279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "바을 제대로 들었는데 안 졸리다.\n그건 바를 제대로들은 거 아니라고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5340239,
    "dDurationMs": 7521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "생각해요. 아, 음악을 참 이해하는\n사람은 안 졸리지. 전만에 음악을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5344679,
    "dDurationMs": 9601,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이해하면 졸리죠. 음악에 몰입하면 딴\n것도 아니고 바하의 평균율에 대입법을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5350760,
    "dDurationMs": 8680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "따라가는데 안 졸려요. 그거는 어\n음악을 제대로 집중 안 한 거라고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5356679,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "생각해요. 자, 제가 그 제 말씀을\n조금만 더 들어 보세요. 뭐냐면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5361639,
    "dDurationMs": 6881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "데이법은 뭐냐면요.\n데이법은 그거죠. 멜로디가 한마디로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5366239,
    "dDurationMs": 5361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "멜로디가 독립적인 멜로디가 동시에\n나오는 거죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5370406,
    "dDurationMs": 8194,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[목을 가다듬음]"
    }, {
      "utf8": " 우리가 보통 듣는\n음악은 다 하몬이죠. 멜로디가 한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5374840,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "개가 있고 그 멜로디를 밑에서 받쳐\n주는 하머니, 화음 뭐 이런게 있는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5381239,
    "dDurationMs": 7521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거죠.\n뭐 다 그런 거 뭐 락 음악이든 댄스",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5385239,
    "dDurationMs": 10081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "음악이든 뭐 무슨 뭐 케이팝이든 뭐든\n발라드든 뭐든 멜로디는 하라고이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5392920,
    "dDurationMs": 8600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "화음이 다 조성되 있죠. 일반적으로\n우리가 듣는 음악. 근데 희한하게도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5399360,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "대입법 대입 뭐 바음하게만 데법이\n있는 건 아니에요.이 데법은 뭐냐면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5404080,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "화음을 쓰는게 아니라 여러 개의\n멜로디가 동시에 흘라가게 하는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5408520,
    "dDurationMs": 9960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요.\n그래서 상당히 희한한 음악이죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5415520,
    "dDurationMs": 8360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "평균율 well템퍼ed 템퍼 템퍼가\n성격 이런 거잖아요. 웰템퍼ed",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5420480,
    "dDurationMs": 3639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그니까 성격을 막 죽겠 죽였다. 좀\n그런",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5424117,
    "dDurationMs": 6283,
    "wWinId": 1,
    "segs": [ {
      "utf8": "\u003e\u003e [콧방귀]",
      "isSpeakerChange": 1
    }, {
      "utf8": "\n\u003e\u003e 뜻은 아니지만 아무튼 이게 템퍼링이",
      "acAsrConf": 0,
      "isSpeakerChange": 1
    } ]
  }, {
    "tStartMs": 5426360,
    "dDurationMs": 9600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잘 된이 대입법 규칙을 써서 이해하는\n음악은 진짜 엄격하고 어떻게 보면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5433320,
    "dDurationMs": 8640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "굉장히 수학적인 음악이에요. 그리고\n건반학기. 옛날에는 찬발로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5438280,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하프시코드를 피아노 이전에 있던\n피아노 나오기 훨씬 전에 건반학기들",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5444480,
    "dDurationMs": 6840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그걸 위해서 원래 만들었던 거예요.\n근데 요즘은 이제 많이들 피아노로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5448080,
    "dDurationMs": 9039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거를 연주하죠. 이거는 예측\n가능성이 극대화된 음악이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5454800,
    "dDurationMs": 9080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 또 바로 그 음악의 특징이\n절제된 정서예요.이 그 로맨틱하지가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5460199,
    "dDurationMs": 9321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "않아요. 뭐 거기서이 정서가 아주\n그냥 없는 건 아닌데 아주 쫙이 뭐라",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5467360,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그럴까 디서플린이 쫙 돼 있고\n컨트롤이 돼 있고 한 곡이 하나의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5471600,
    "dDurationMs": 9039,
    "wWinId": 1,
    "segs": [ {
      "utf8": "정서를 끝까지 유하죠. 다른 어떤 그\n무슨 뭐 리스트나 배토벤 이런 거는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5477639,
    "dDurationMs": 10321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐 조용했다가 뭐 격렬했다가 뭐 뭐\n평화로 왔다가 뭐 느낌이 막 다양하게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5484400,
    "dDurationMs": 8880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나오잖아요. 근데 이거는 그냥 당당\n아주 비슷한 거 어떻게 보면 얼핏",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5489840,
    "dDurationMs": 10040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "들으면 지루한데 그 지루함을 따라가서\n그 안에 구조를 들어가 보면 정말",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5496560,
    "dDurationMs": 9159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "우주적입니다. 우주. 예. 그래서\n낭만주의 음악처럼 막 긴장해서 꽉꽉",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5502840,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "막 이런 것도 없고 크레센도 뭐 점점\n막 세게 올라갔다 조용했다 이런 것도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5507880,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "없어요.\n왜냐면 사실은 그런 걸 없을 수밖에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5512199,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "없는게이 원래이 바하시 이거는\n피아노가 없었단 말이에요. 피아노라는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5516880,
    "dDurationMs": 9720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "악기는 원래 피아노 포르테에 준\n말이에요. 피아노는 살살 약하게 포르",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5522280,
    "dDurationMs": 9913,
    "wWinId": 1,
    "segs": [ {
      "utf8": "때는 강하게 그래서 건반기 건반학기를\n피아노를 살살 치면 소리가 살살",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5528840,
    "dDurationMs": 5720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나죠. 피아노 살살 피아니시모 살살\n[목을 가다듬음]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5532760,
    "dDurationMs": 6160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "세게 치면 포르테 그 꽝 소리가\n나잖아요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5536080,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그게이 피아노 포르테라는이 악기의\n특징이에요. 살살 치면 소리가 살살",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5541080,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나요. 세게 치면 그럼 옛날에는\n옛날에는 그 소리 조절이 잘 안",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5545760,
    "dDurationMs": 5040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "됐어요. 챔발로 저 하프시코드라고\n하는 거 빵빵빵빵빵 이게 건반이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5549360,
    "dDurationMs": 6600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이중으로 돼 있고이 빵빵빵빵 하는\n거는 피아노 포르테가 안 돼요. 살살",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5553600,
    "dDurationMs": 10240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "치든 세게 치든 그냥 균일하게 소리가\n난단 말이에요. 그러니까이 곡 자체가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5560280,
    "dDurationMs": 10439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 곡을 피아노로 옮겨 쳐도\n뭐 저기 그 뭐 글랜골드 같은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5567600,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자유로운 영어는 막지 맘대로 빠르게\n뭐 느리게 세게 뭐 이렇게 하지만",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5573639,
    "dDurationMs": 6401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "원래대로\n하면은 진짜 절제된",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5578440,
    "dDurationMs": 6679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거의 뭐\n크고 작고 빠르고 느리게도 거의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5582679,
    "dDurationMs": 6960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "비슷하게 한곡에 그대로 그렇게 된\n거예요. 그래서 얼핏 들으면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5587920,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지루해요.\n하나의 정서가 끝까지 유주돼 있어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5592320,
    "dDurationMs": 8760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "올라갔다 내려갔다가 없어요.이\n크레센도 막 확 긴장 막 해면 막",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5597159,
    "dDurationMs": 10040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "감동 그럼 교감신경 활성화돼요.\n그런데 한마디로 네러티가 없어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5604960,
    "dDurationMs": 9640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "서사가 없어요.\n정서적 예측 오차가 없어요. 그냥 한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5611320,
    "dDurationMs": 8680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "덩어리예요. 정서가 한 덩어리예요.\n음악도 그냥 한 덩어리라고요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5617239,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러니까 어떻게 돼요? 예측 오류\n날게 별로 없어요. 뇌는 다음 소리를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5623040,
    "dDurationMs": 10880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "예측하고 예측이 빛나가면 각성하죠.\n그게 그 저 칼프리스틴이 얘기하는 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5631040,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저 그 예측 오류 그 예측 모형 뇌\n예측 모형이에요. 프리 에너지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5635520,
    "dDurationMs": 7159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "프ci플이라는 거예요. 자유에너지\n원칙이라는 거예요. 그게 뭐냐면 뇌는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5639400,
    "dDurationMs": 8680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭘 하는 거냐면 예측 오류에 집중해서\n그거 수정하는게 뇌하는 일이다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5645360,
    "dDurationMs": 7319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러니까 예측 자꾸 빛나가면\n서프라이즈 생기고 각성하죠. 그런데이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5651119,
    "dDurationMs": 9961,
    "wWinId": 1,
    "segs": [ {
      "utf8": "바음악은\n예측 빛나갈게 없어요. 예측 오차가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5656360,
    "dDurationMs": 11080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거의 없어요. 일정한 박 박자 급격한\n강약 변화 부제 강약을 할 수가 없는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5664239,
    "dDurationMs": 7681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시대 음악이니까. 그다음에 엄격한\n규칙 위에 미세한 변화.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5672560,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "평균율은\n제가 보기에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5676760,
    "dDurationMs": 5240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면을 위한 최고의 음악입니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5684000,
    "dDurationMs": 8159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그리고 평균율이\n곡 중에 이제 프렐루드랑 이제 후가로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5689800,
    "dDurationMs": 7640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돼 있잖아요. 평균율이 뒷부분에 쭉\n나와 있는 후가 부분 거기에 특히",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5695440,
    "dDurationMs": 10600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "물론 프렐루이드도 좀 있기도 하지만\n후가 부분에 대입법에이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5700679,
    "dDurationMs": 12520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "성부가 있어요. 멜로디 그러면 성부\n잠깐만요. 그러면 이게 지금 멜로디",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5708480,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "흘러가는 거를 이걸 이걸 들으면\n소리가 나나?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5715840,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "제가 저기 뭐야? 음악 음악 소리를\n좀 들어 볼게요. [음악]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5720080,
    "dDurationMs": 10280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "좀 플레이해 볼게요. 소리가 나요,\n지금. 어,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5727679,
    "dDurationMs": 5657,
    "wWinId": 1,
    "segs": [ {
      "utf8": "캐아노 소리 [콧방귀] 이게 되나 안\n되나 모르겠네. [음악]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5733360,
    "dDurationMs": 7181,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저기 댓글로 음악 소리 나요. 어,\n예. 됐어요. 예. 감사합니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5738521,
    "dDurationMs": 2020,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[음악]"
    } ]
  }, {
    "tStartMs": 5741760,
    "dDurationMs": 11320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게\n[음악] 지금이 음악이 대입법을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5748239,
    "dDurationMs": 9880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "보여주는 한 사례입니다.이 음악이\n이게 보면은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5754960,
    "dDurationMs": 7840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "위에 따라 위에 한 멜로디가 가죠.\n근데 밑에도 멜로디가 가죠. 이거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5760679,
    "dDurationMs": 5520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "화음이 아니죠.\n별개 멜로디예요.요",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5766719,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "요거 구분이 됐어요? 좀 한번 하려고\n노력해 보세요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5774880,
    "dDurationMs": 3680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가만 있어 봐요. 여기",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5781040,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 화음이 아니에요. 흔히 듣는 어\n화성이 아니에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5798920,
    "dDurationMs": 7600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "밑에도 화음을 잡는게 아니라 단단\n느리게 가는 것도 있고 빠르게 가는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5803080,
    "dDurationMs": 3440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "것도 있고. 그렇죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5811880,
    "dDurationMs": 9720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러면 요건 요만큼 듣고\n요번에는 좀 다른 거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5819320,
    "dDurationMs": 6799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하나\n더 쉬운 거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5823840,
    "dDurationMs": 9399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "해 볼게요.\n예. 여기 추천 제가 추천에 요것도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5833960,
    "dDurationMs": 8239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어 요거 여기 보면 좀 뒤에\n슬라이드에 이거 있어요. 그럼 오늘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5838880,
    "dDurationMs": 11720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "밤 뭐 들어야 주무실까요? 추천 제가\n딱 여기 다섯 개. 예. 오 1분",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5846600,
    "dDurationMs": 10160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "40분.요 합치면 15분짜리 요거를에\n그럼 이거이 음악 어디서 구해? 아니",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5852880,
    "dDurationMs": 10440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐 저기 그 뭐죠? 유튜브 가도 있고\n어 뭐 어디든 다 있을 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5858920,
    "dDurationMs": 10199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거이 곡은 바 평균율이 어떤 음악\n서비스든지 다 있을 거예요. 자",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5865880,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그중에 제일 쉬운 거이 제일 쉬운\n거부터 지금 가는 거예요. 삼성 후가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5871880,
    "dDurationMs": 7560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "쉬운 거. 4성 어렵고 5성은\n포기하세요. 근데 왜 포기해야 될 걸",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5877080,
    "dDurationMs": 9440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "왜 넣나 이따 설명드릴게요. 제일\n쉬운 거 리듬에 윤거. 그래서 이게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5882520,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "왜 쉽냐면 처음에 한 선율로\n시작됩니다. 한 개. 한 개.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5888360,
    "dDurationMs": 8680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러니까 한 개를 따라가는데 어느새\n두 개가 시작돼요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5893920,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "예. 그거만이라도 알아차리면 어 이게\n따라갈 수 있어요. 그다음에 좀 더",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5898719,
    "dDurationMs": 6841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가다 보면 세 개\n찾아서 네. 들어보시면 돼요. 자,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5903719,
    "dDurationMs": 6721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그럼 이게 왜 수면에 도움이 되는\n이게 좀 이제 약간 설명을 드려야",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5908440,
    "dDurationMs": 7719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돼요. 그냥 막 어, 막 좋다. 이게\n아니라 왜",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5913400,
    "dDurationMs": 9600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "대입법 성부를 따라가면 졸린가?이\n멜로디를 따라가면 왜 강한 졸름이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5919639,
    "dDurationMs": 8960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "유도되는가? 그걸 설명을 드릴게요.\n먼저 지금 설명드린 대로이 서양",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5925599,
    "dDurationMs": 8721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "음악의 직조 방식이 화성음악과이\n대위법이 있는데 낭만주의 이후 뭐",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5932840,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "베토벤이니 뭐니 그 뒤에 그다음에\n현대 대중이 현대 대중 음악 우리가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5936880,
    "dDurationMs": 9279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아는 뭐 케이팝 가요 뭐 트로트 뭐\n등등등다는 다 화성음악이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5943538,
    "dDurationMs": 8382,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[콧방귀]"
    }, {
      "utf8": " 그 최상 성부에 뚜렷한\n단일 멜로디 하나가 있고 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5948760,
    "dDurationMs": 7560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나머지들은 다 화음 반주인 거죠.\n그럼 어떻게 돼? 뇌는 어떻게 돼요?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5953239,
    "dDurationMs": 8121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런 음악들을 때 단일 주선율 하나만\n추적하고 우리는 흥얼흥 그 노래 나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5959960,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저 아는 노래야 그러면 흥얼흥을\n따라할 때 그 주 멜로디만 따라하면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5963679,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "되죠.\n그래서 작업 기억에 남는 잉여",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5968280,
    "dDurationMs": 9319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "대어폭이 많이 발생해요.\n그 빈틈으로 일상적 걱정이나 반추가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5974639,
    "dDurationMs": 11161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "침투할 수 있어요. 다시 말해서\n우리의인지 능력을 충분히 다 뺏어가지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5981320,
    "dDurationMs": 10399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "못해요. 반면에 지금 들으신 바율\n후가나 골드베르그 변주곡이나 뭐",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5988159,
    "dDurationMs": 9960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "카논이나 인벤션 심포니 이거 이런 바\n대입법 음악들은 주선율과 반주의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5995280,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "위계가 없어요. 무슨 얘기냐면 메인\n멜로디가 없어요. 사실은 맨 처음에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 5999760,
    "dDurationMs": 6600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시작한게 메인 멜로디 같죠?\n아니에요. 사실은 그건 메인 멜로디가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6002960,
    "dDurationMs": 8719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아니라 먼저 시작했을 뿐이에요.\n그래서 두 개, 세 개,네 개, 다섯",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6009320,
    "dDurationMs": 11240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "개까지 막\n똑같은 자격을 지닌 독립적인 선율들이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6017199,
    "dDurationMs": 7081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "동등한 자격을 지닌 채 쫙 지나가요.\n그래서 이런 곡은 그 어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6023449,
    "dDurationMs": 4230,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[목을 가다듬음]"
    }, {
      "utf8": "\n멜로디 중에 어느 걸 하나 외워서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6025840,
    "dDurationMs": 7640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내가 따라부른가 이런 것도 잘 안\n돼요. 메인 멜로디가 없기 때문에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6031280,
    "dDurationMs": 8319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 잠자리에 누워서이 대입법\n악곡에 독립된 성분을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6036320,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "귀로 분리해서 추적 처음에는 훈련을\n좀 하셔야 돼요. 이게 근데 금방 될",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6041520,
    "dDurationMs": 6880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거예요.이 쉬운 곡 제가 이제 추천해\n드릴테니까 분리가 잘 되는게 있고 안",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6045520,
    "dDurationMs": 7719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "되는게 있어요. 그래서 처음부\n처음부터 이렇게 해서 분리가 되는 거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6051880,
    "dDurationMs": 8080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "쉬운 거부터 어려운 것까지 제가 다섯\n개 뽑아 놨으니까 그걸 들어 보세요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6056440,
    "dDurationMs": 9480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러면 인간의 작업 기억 수면 개시\n조절 요시 고도로 특수한 인지적",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6063360,
    "dDurationMs": 9759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "현상이 일어나요. 뭐냐하면 바로\n우리가 원하는게 뭐냐? 작업 기억의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6068199,
    "dDurationMs": 9721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "점유와 반추 밀어내기. 이게 반추\n이런 거가 우리를 각성시키는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6075440,
    "dDurationMs": 8920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거거든요. 자, 그러면\n일단 작업 기업 다중 성분 모델에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6080800,
    "dDurationMs": 11600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "따르면 인간의 의식적 정보 처리는\n언어적 청각적 정보를 내면의 목소리로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6089599,
    "dDurationMs": 7441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "유지하고 되내는 좋은 루프,\n포널로지컬 루프가 있어요. 그래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6095599,
    "dDurationMs": 7161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "우리가 의식 정보 처리할 때 막\n생각을 하면 언어적 이런게 약간 그걸",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6100679,
    "dDurationMs": 5401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내면의 목소리라고도 하잖아요. 뭐\n우리 식으로 얘기하면 내면 소통이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6104400,
    "dDurationMs": 7239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "되겠죠.\n그 그 일종에 좋은 루프가 있고요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6108880,
    "dDurationMs": 10359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그다음에 또 인간의 의식 정보 처리는\n시각적 공간적 심상을 조작하는 시공간",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6115960,
    "dDurationMs": 9279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "메모장 비주얼 스페셜 스케치패드 같은\n거. 그래서 뭔가 어떤 걸 생각할 때",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6122400,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어 뭐 그때 걔가 뭐라 그랬지? 또\n내가 뭐라고 생각하지 할 때 그게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6127840,
    "dDurationMs": 10240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "언어적으로 막 이렇게 좋은 루프가\n돼서 들리듯이 돌아가기도 하고 또",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6135239,
    "dDurationMs": 8081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "눈으로 보듯이 아 그때 여기서 일로\n가고 저기서 저로 가고 얘가 이렇게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6139679,
    "dDurationMs": 10480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "되고 그런 비주얼하게 이렇게 시공간\n메모장을 우리 뇌에서 그리기도 하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6147080,
    "dDurationMs": 8519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그리고 제한된 주의자연 우리 어텐션에\n우리 의식에 주의자연이 제한되 있는데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6153040,
    "dDurationMs": 9880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거를 잘 배분하고 통제하 하는\n센트럴 ex젝티브 하는 그게 주로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6158440,
    "dDurationMs": 11320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "워킹 메모리 컨트롤하는 그런 그 저기\n뭐야이 기능들이 있는 거예요.이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6165360,
    "dDurationMs": 11160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뇌에. 그런데 불면증 환자가 입면전\n침대에 누웠을 때 작업 기억을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6172760,
    "dDurationMs": 9760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "장악하는 주체는 주로 어떤 생각이\n떠오르고 뇌가 어떤 일을 하냐면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6178679,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "과거의 후에 미래의 위협. 아 내가\n오늘 왜 그랬을까? 아, 내일 이거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6184719,
    "dDurationMs": 7801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어떡하지? 이런 과거의 후에 미래\n위협이 언어적 사술로 쫙 머리에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6190840,
    "dDurationMs": 5839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "떠올라요. 그게 반추예요.\n루미네이션.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6194080,
    "dDurationMs": 6920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그걸 우리는 걱정이라 그래요. 이게\n점점 각성시키는 거죠. 그래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6198991,
    "dDurationMs": 8329,
    "wWinId": 1,
    "segs": [ {
      "utf8": "[콧방귀]"
    }, {
      "utf8": " 내면의 독백 형태로\n진행되는 이러한 경험자의 스토리텔링,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6204440,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "경험자의 부정적 스토리텔링이죠.\n이거는이 조음 루프 우리의 뇌에서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6210080,
    "dDurationMs": 7800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돌아가는이 스토리텔링의이 조음 루프를\n딱 독점하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6214199,
    "dDurationMs": 11161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "중앙 집행기를 딱 장악해서 각성을\n유지시키죠. 즉 제한된 용량을 지닌",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6221400,
    "dDurationMs": 9319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "작업 기억에서 우리의 뇌가 언어적\n반출을 막 하고 있는 상태인 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6228800,
    "dDurationMs": 5879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 아까 얘기했듯이 그럼이 언어적\n반출을 없애야 우리가 자는데 어떻게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6232920,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이걸 눌러요? 누르려니까 더 안\n되죠. 이거 없애는 방법은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6239159,
    "dDurationMs": 6841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "딴 데다 어텐션 주는 거예요. 한\n한마디로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6242960,
    "dDurationMs": 8080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "경쟁적 간섭을 하는 거예요. 이게\n우리의 뇌이 기능 작업 기억 이런",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6248280,
    "dDurationMs": 6319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "기능은 리소스가 제한돼 있다니까요.\n무한히 여러 가지를 할 수 있지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6252400,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "않아요. 우리의 어텐션이 어느 한\n쪽으로 확 몰리면요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6257239,
    "dDurationMs": 8081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저쪽으로는 못 가는 거예요. 그러니까\n불면증 환자는 [목을 가다듬음]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6262719,
    "dDurationMs": 7960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "반추, 나쁜 생각, 스토리텔링,\n과거에 대한 걱정, 미래에 대한 걱정",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6267520,
    "dDurationMs": 9320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런 걸 하고 있는 상태니까\n그거 못 하게 하려면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6273000,
    "dDurationMs": 10800,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어텐션을 딴 데로 쫙 주면 되는\n거예요. 근데 어텐션을 쫙 주는데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6281080,
    "dDurationMs": 8599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "대입법에서 소프라노 알토베이 독립적인\n선율을 동시에 분리하여 인식하는 거.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6287599,
    "dDurationMs": 6881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "멜로디의 진입을 추적해. 아, 이거\n첫 번째 간다. 두 번째 간다. 세",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6291800,
    "dDurationMs": 6600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "번째 간다. 이거 하려면\n엄청",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6296000,
    "dDurationMs": 6040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "머리를 많이 써야 됩니다. 리소스가\n많이 들어요. 쉬운 일이 아니에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6300520,
    "dDurationMs": 5119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그게\n그냥 따라가지지가 않아요. 여러분",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6303560,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "한번 해 보세요. 이게 뭐지? 그냥\n막 섞여서 들리는데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6308119,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "두 개, 세 개 나눠지지 않는 데가\n돼요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6311960,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그거를. 아, 여기서부터 한 개인데\n뭔가 복잡해진 거 같아. 근데 그거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6316040,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "두 개를 쫙 분리해서 아,요\n멜로디,요 멜로디,요 멜로디,요",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6319960,
    "dDurationMs": 8520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "멜로디를 분리해서 들으려면\n엄청나게 거기다가 어텐션을 줘야",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6325119,
    "dDurationMs": 8441,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돼요. 그다음에 청각 장면 분석와\n조음 루프 있잖아요. 그거 다 장악이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6331040,
    "dDurationMs": 7720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "되는 거예요. 왜냐면이 조음 루프를\n우리가 그 어 내면 소통이나 내면의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6336040,
    "dDurationMs": 7079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "목소리가 걱정을 하는데 그거 할\n애들이 다 멜로디 따라가야 되는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6340920,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거야. 홍 이거 달라 속으로 그걸\n따라가는 거예. 성부관 주의 전환을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6345480,
    "dDurationMs": 8239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "통제하는 중앙 집행기의 대역폭을\n완전히 점유해 버려요. 한마디로 딴",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6351320,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "생각이 안 일어나요.\n걱정할이 여유가 없어요.이 뇌에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6355840,
    "dDurationMs": 8399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "여유가 없다고. 이거 따라가다 보면.\n그래서 조음 루프와 중앙 재행기가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6360880,
    "dDurationMs": 8319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "대입법 선율 추적에 100% 할당이\n100% 할당해도이 훈련 잘 안 되고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6367040,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "웬만한 사람들은 이거 나눠 들으려고\n그러면 100% 갖고도 모 잘라요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6373280,
    "dDurationMs": 5879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "집중하고 더 집중하고 더 집중해야\n돼. 딴 생각 아무것도 못 하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6377040,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거에만 집중을 해야 좀 될 수\n있어요. 그래서 작업 기억 내부에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6381639,
    "dDurationMs": 9721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내면의 목소리로 걱정을 되내고 뭐 뭐\n뭐 반추하고 이런 위협 시나리오",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6389159,
    "dDurationMs": 5881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시뮬레이션하고 걔가 그때 뭐라\n그랬지? 나는 뭐라 그랬어야 되는데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6393000,
    "dDurationMs": 10239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐 이런\n이런 스토리텔링을 할 그런 워킹",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6398440,
    "dDurationMs": 9199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "메모리의 여유 공간 자체가 없어져요.\n반출을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6404760,
    "dDurationMs": 7160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "밀어내 버려요. 루미네이션을 억눌게\n아니라",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6409159,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거 들으려는 노력이\n대입법 성부 하나하나 멜로디 하나하나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6415599,
    "dDurationMs": 7481,
    "wWinId": 1,
    "segs": [ {
      "utf8": "들으려는 노력이\n반추하려는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6419760,
    "dDurationMs": 8879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뇌 영역을 다 장악해 버려 가지고\n내 뇌로부터 반출을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6426639,
    "dDurationMs": 9161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "밀어내요.\n보도행의 수면 정보 처리 이론을 한번",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6432800,
    "dDurationMs": 6799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "살펴보세요. 이거 들어보 살펴봅시다.\n뭐면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6437360,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수학제 자 여기서 보면 재밌죠. 수학\n문제 풀거나 내일의 업무 기획관을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6442320,
    "dDurationMs": 9240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "구생하는 것도 작업 기업 중앙\n집행기에 100% 점유에요. 그런데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6448760,
    "dDurationMs": 7640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수학 문제 풀려고 막 고민하거나 내일\n업무기에 이것도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6453800,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "집중인데 왜 그 집중은 뇌를\n각성시키는데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6458560,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "대입법 성부 추적하는 거 그것도\n엄청난 집중이거든요. 그 집중은 왜",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6463560,
    "dDurationMs": 9880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "졸리게 만드는가?\n그게 바로 보두행과인지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6469800,
    "dDurationMs": 7879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "철학자 슬로만 등이 얘기하는 수면\n정보 처리 이론이에요. 그리고 인주적",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6475840,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "셔플 이론 곧 나와요. 인주적 셔플\n이론이 인간 내수면 개시 조절",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6480880,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시스템은 수면이라는 진화적으로 취약한\n상태에 진입하기 전에 그게 무슨",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6486000,
    "dDurationMs": 6679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "진화적으로 취약한 상태가 뭐냐면 잠\n잘면은에 뭐 이렇게 취약한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6491000,
    "dDurationMs": 8520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "상태잖아요.\n다른 짐승에에 잡혀 먹을 수도 있고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6496040,
    "dDurationMs": 9280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 진입하기 전에 뇌네피질\n정보 처리 양상을 감시해서 야 지금",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6502719,
    "dDurationMs": 8241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "말이야이 대뇌에서 이러저러한 정보를\n처리하는데 지금 잠자도 되는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6507639,
    "dDurationMs": 8241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "상황일까? 지금 안전한가? 이거를\n파악해요. 그게 뭐냐면 수면 계시",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6513920,
    "dDurationMs": 7719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "조절 시스템이에요.\n우리 뇌는 자동으로 그걸 해요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6519280,
    "dDurationMs": 5240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 아, 안전하구나 그러면\n안전하니까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6523239,
    "dDurationMs": 9681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠들어도 되겠다. 이렇게 되는\n거예요. 이때 수면 진입을 즉각",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6529000,
    "dDurationMs": 8679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "차단하는 불멸을 불면을 유발하는 정신\n활동은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6535000,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지요한 동기 유발자가 실행 기능을\n장악하려는 긴급 상태 즉 논리적이고도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6541239,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일관된\n인과적 서사의 처리. 여기서 중요한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6545320,
    "dDurationMs": 9319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "컨셉이 인과적 그러니까 인과 관계\n이게 원인과 결과 인과적인 서사",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6551840,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "스토리텔링의 처리인 거예요. 다시\n말해서 수면에 들어가려고 하는데 안",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6558159,
    "dDurationMs": 5560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돼. 수면 지금 들어가면 안 돼라는\n건 뭐냐하면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6561719,
    "dDurationMs": 7361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "집요한 동기 유발자 우리 전주협에\n있는 어떤 일을 해내려는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6566199,
    "dDurationMs": 8081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "걔가 실행 기능을 장악하려고 그래.\n우리 뇌 실행 기능을 장악하는 긴급",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6571520,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "상태. 그 긴급 상태가 뭐냐면 지금\n이래서 이랬으니까 저래서 저러니까이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6576159,
    "dDurationMs": 8401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런 스토리텔링을 계속 하고 있는\n상태예요. 그러면은 뇌 입장에서 볼",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6581480,
    "dDurationMs": 8960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "때 내일 무슨 일 해야지 하는 걸\n계획하는 거라든지 과거 이래서 이래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6587480,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저래 반추한다든지 수학 문제 렇게 되\n이렇게 되 심지어 관심 있는 단일",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6593040,
    "dDurationMs": 7280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "주제에 대해서 깊이 있게\n생각하잖아요. 그럼 되네의네피질은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6597840,
    "dDurationMs": 8080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "A에서음 그다음에 B에 거쳐음 C에\n거쳐 이런 일관되고 코어런트하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6603560,
    "dDurationMs": 6639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "논리적인 로지컬한\n네러티브티",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6608199,
    "dDurationMs": 6641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "스토리텔링의\n연속",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6611840,
    "dDurationMs": 8759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그걸 처리하고 있으면요 수면 계시\n조절 시스템은 이걸 뭐라고 판단하냐면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6619000,
    "dDurationMs": 5199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "야 아직 해결하지 못한 문제가\n있구나.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6622560,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아, 이거 아무래도 잠들기 안전하지\n않은 거 같다. 지금 대네피질에서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6626800,
    "dDurationMs": 7319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지금 서사를 쓰고 있잖아. 좀\n인강관계 따지고 있잖아. 이러고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6632320,
    "dDurationMs": 6919,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저러고 이러고 저러고 논리적 생각하고\n있잖아. 이건 아직 문제가 다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6636599,
    "dDurationMs": 8281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "해결되지 않은 거 같아. 이게 잠잠면\n안 될 상황이야. 이렇게 판단해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6641800,
    "dDurationMs": 8600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "각성을 유지한다는 겁니다. 그러니까\n여러분 주무시기 전에 아무 생각이라도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6648639,
    "dDurationMs": 6641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아무 생각을 하죠. 어떤 뭐 생각을\n해. 근데 그게 이러니까 저렇고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6653000,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저러니까 저렇고 이러니까 이렇겠지라는\n논리가 들어가고 인가관계가 들어가죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6657880,
    "dDurationMs": 8799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그럼 잠깨니다.\n그게 수면 정보 처리 이론이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6662960,
    "dDurationMs": 8920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 논리적인 네러티\n그런 어떤 스토리텔링 인가관계적인",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6669239,
    "dDurationMs": 7252,
    "wWinId": 1,
    "segs": [ {
      "utf8": "네러티 그런 스토리텔링 이거 하지\n말아야 돼요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6673840,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그럼 뇌가 각수형이 돼요. 그다음에\n[콧방귀]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6678280,
    "dDurationMs": 9760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 불면 유발 서사를 차단하고 그\n불면증을 불러일으키는 잠깨 하는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6684760,
    "dDurationMs": 10640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "각성을 불러일으키는 네러티이\n스토리텔링을 막고 수면 유발을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6691239,
    "dDurationMs": 8801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "유도하기 위해서 보드이 설계한 기법이\n인지어 쇼프리예요. 이거는 많은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6698199,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "사람들이 해봐서 이게 지금 효과\n있다. 이렇게 돼 있어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6702079,
    "dDurationMs": 9241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그리고 실제로 무슨 쇼트나 뭐 이런데\n보면 이거 하라고 어 잠 잘다는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6709040,
    "dDurationMs": 6639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "법에서 막 얘기하는 것도 저 본 적이\n있어요. 어떤 쇼트인가 무슨 릴스인가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6713400,
    "dDurationMs": 8360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런 데서 그게 바로이 인지적\n셔플이에요. 이게 뭐냐면 연속적",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6719480,
    "dDurationMs": 8840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "다양제\nSDI 또는 seral div스",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6726119,
    "dDurationMs": 11480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "imaging SDI라고 하는 그런\n테스크 그거예요. 원속적 다양상이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6732159,
    "dDurationMs": 11721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐냐면 아무런 인과 관계 없는 다시\n말해서 스토리가 안 되는 다시 말해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6742360,
    "dDurationMs": 5879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아무거나\n개념을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6745520,
    "dDurationMs": 9159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이것저것 생각하는 거예요. 아무\n단어나 아무 개념이나 근데 이게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6752520,
    "dDurationMs": 6079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "연결이 되면 안 돼요. 논리적으로.\n그러니까 생각을 하는데음",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6757040,
    "dDurationMs": 7559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "강아지\n강아지 동물",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6761000,
    "dDurationMs": 8199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아프면 동물 병원 동물 병원 가야지\n병원에서선 수술하고 수술은 의사가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6767159,
    "dDurationMs": 7241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하는 거고 이런 식의 생각하잖아요.\n그럼 강아지부터 의사까지 연결돼",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6771239,
    "dDurationMs": 10400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있죠. 이건 안 되는 거예요.\n그게 아니라 진짜 랜덤하게 강아지,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6777800,
    "dDurationMs": 10240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "컴퓨터 은하수,\n안경,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6784239,
    "dDurationMs": 9721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "배고파 뭐 아무거나 이렇게 생각나는데\n툭툭 그걸 5초 10초 간격으로 계속",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6791079,
    "dDurationMs": 10881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "툭툭 던지는 거예요.\n또는 bad 타임",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6797040,
    "dDurationMs": 11159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "침대들 시간 그럼 B의 한 단어.\n이해한 단어 뭐 이런 거 한데든지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6806280,
    "dDurationMs": 6240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "음성 안내를 활용하여 그래서 이런 거\n하라고 앱도 개발한 거 같아요. 앱에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6810599,
    "dDurationMs": 7281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이제 그런 뭐 이렇게 하는 훈련 그게\n나오죠. 한마디로 뭐냐면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6815400,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "머리를 쓰는 거예요. 어텐션을 주는\n거예요. 가만히 있는게 아니에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6819199,
    "dDurationMs": 7121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그냥 가만히 있으면 온갖 스토리텔링이\n일어나니까 어떡하냐면 스토리텔링은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6824440,
    "dDurationMs": 7639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "인과관계가 있잖아요. 서술이 되다.\n이래서 이렇고 이래서 이렇고 이러고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6828199,
    "dDurationMs": 10641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "논리가 있잖아요. 그거 없는\n그냥 서사적 연결이 없는 그것도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6835560,
    "dDurationMs": 8159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "중정서적으로 뭐 아니면 뭐 뭐 어 피\n튀기는 막 이렇게 뭐 이런 폭력적이고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6841199,
    "dDurationMs": 11201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐 불행한 이런 거 말고 정서적으로\n중립적인 단어와 구체적인 이미지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6849159,
    "dDurationMs": 10201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐에 점프한다, 돈다, 달린다, 이런\n운동 감각적인 팔을 넓게 펼친다. 뭐",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6855480,
    "dDurationMs": 11719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런거든 그런 구체적 이미지 뭐\n그야말로 아무 생각이나 막 연결 안",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6862360,
    "dDurationMs": 10560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "되게 5초 10초씩 빠르게 전환하면서\n강아지 했다가 한 5초 만에 은하수",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6869800,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "했다가 한 5초 만에 안경 했다가 또\n한 5초 만에 식당 했다가 또 한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6875239,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "5초 만에 마이크 했다가 어 또 한\n5초 만에 구두 했다가 뭐 이런",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6880440,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "식으로 근데 떠올릴 때 그걸 생각해야\n돼요. 구두 그러면 구두를 생각하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6885960,
    "dDurationMs": 5440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "마이크 그러면 마이크를 생각하고\n은하수 그러면 은하수 생각 이렇게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6889119,
    "dDurationMs": 7641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하는 거예요. 그래서 이때 핵심은\n단어나 이미지들을 서로 연결해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6894360,
    "dDurationMs": 6719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하나의 줄거리로 만들지 말아야 돼요.\n또는 하나의 줄거리에서 나오는 단어면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6899280,
    "dDurationMs": 8160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "안 돼요.\n서로 상관이 없는 대상으로 주의를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6904440,
    "dDurationMs": 9520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "툭툭 전환하면서 그럼 어떻게 되냐면\n작업 기억에 우리 대내 작업 기억의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6910719,
    "dDurationMs": 8520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "중앙 집행기가 열심히 일해야 돼요.\n랜덤한 상관없는 단어 하나씩 던져",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6916040,
    "dDurationMs": 11320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "놓고 거기를 생각해야 되니까.\n일관된 걱정사 코어런트한 어떤 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6923480,
    "dDurationMs": 8119,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나쁜 생각에 형성이 될 여지가 없죠.\n다시 말해서 에너 그이 리소스를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6929400,
    "dDurationMs": 7679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "빼가는 거예요. 뇌를 다른데 쓰게\n하는 거예요. 논리적 연결이 해체된",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6934320,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "단편적 심상의 흐름 자체가 실제\n임명기에 자연스러운 뇌 활동을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6939560,
    "dDurationMs": 7360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "모방해요. 이게 무슨 실제 잠들 때쯤\n되면 우리 뇌는 그렇게 랜덤하게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6945159,
    "dDurationMs": 8281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "튀어다닙니다.\n논리적인 스토리텔링을 하는게 아니라.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6949480,
    "dDurationMs": 7560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 그 실제 입면기 잠들 때의 뇌\n상태와 비슷한 상태를 만들어 버리는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6955599,
    "dDurationMs": 9281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거죠.\n실제로 154명을 대상으로 수행한",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6959840,
    "dDurationMs": 12279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "무작기 대조 어 임상 연구에서 취침시\n인지적 쇼프를 시행한 집단은",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6968520,
    "dDurationMs": 11480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "인면전 인지적 신체적 과각성과 수면\n노력이 쫙 감소하고 수면의 질이 대폭",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6976760,
    "dDurationMs": 8879,
    "wWinId": 1,
    "segs": [ {
      "utf8": "향상되었다 하는 거예요. 그래서 어떤\n스토리텔링이나 걱정 이런 거에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6981719,
    "dDurationMs": 7281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "집중하는게 아니라 엉뚱한 딴 거,\n무회한,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6987239,
    "dDurationMs": 7161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "정서적으로 뉴추럴한 이런 거에\n집중하는게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6990760,
    "dDurationMs": 11120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 잠자는데 도움이 된다 하는 그런게\n인지적 셔플 이거이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 6998520,
    "dDurationMs": 9159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "얘기입니다. 그래서 수면 정보 처리\n이론과 인지적 셔플의 작동 요건을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7005840,
    "dDurationMs": 7080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "보면\n이게 무슨 얘기냐면 이런 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7009440,
    "dDurationMs": 9719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐냐면 수면 정보 처리와 인주적 플어\n랜덤하게 하는 거 그거에 그 요구",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7016840,
    "dDurationMs": 10239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "조건들이 있거든요.\n그거의 관점에서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7022159,
    "dDurationMs": 10520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "바하의 평균율 이입법 음악을 바라보면\n완벽하게 구현하는 거예요. 자,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7029159,
    "dDurationMs": 8721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "보세요. 조음 루프와 중형, 중앙\n집행기 점유하죠. 왜냐면 멜로디니까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7036199,
    "dDurationMs": 6480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "소리가 돌아가는 거 그거 따라가는\n거잖아요. 그다음에 비서사적이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7041199,
    "dDurationMs": 6561,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그렇죠. 이게 무슨 스토리예요? 음악\n왔다 갔다 놨다 갔다. 멜로디인데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7044800,
    "dDurationMs": 10080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "비정서적. 예.이 낭만주의가 아니라\n그랬잖아요. 그냥 기계적이고 수학적인",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7051480,
    "dDurationMs": 8280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런 중립 자극이죠. 그다음에 5초\n내지 10초 간격으로 주의 전환이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7057199,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일어나야 돼요. 그런데 우리가이\n멜로디를 동시에 듣는게 사실 잘 안",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7062560,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "됩니다. 우리 뇌는 어떻게 되냐면\n멜로디 두 개 2성 또는 3성이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7068000,
    "dDurationMs": 8280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "흘러간다고 하면\n좀 아래 높은 뭐지? 잠깐 듣다가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7073360,
    "dDurationMs": 7560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "중간은 뭐지? 잠깐 듣다가 맨 밑에\n뭐지? 멜로디 뭐지? 맨 밑에 멜로디",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7079280,
    "dDurationMs": 4600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거 흘러가는구나. 아 중간에 이거\n멜로디 흘러가네. 이게 흘러가네.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7082599,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런 식으로 왔다 갔다 하게 돼\n있어요. 동시에 똑같이 세 개를 잘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7086480,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "듣기 힘들어요.\n아주 뭐 특수한 경우에는 그러신 분도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7091159,
    "dDurationMs": 7401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "계시겠지만 보통은 멜로디 하나\n따라가다 어 여기에 어 두 번째 요런",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7095639,
    "dDurationMs": 6841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "것도 있네. 어, 근데 그 멜로디 첫\n번째 멜로디, 두 번째 멜로디, 세",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7100280,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "번째 멜로디 왔다 갔다 하는 그\n간격이 보통 5초에서 10초예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7106159,
    "dDurationMs": 8241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 이상 잘 안 돼요. 그 이거 이거\n이거에 딱 맞는 거예요. 그다음에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7110960,
    "dDurationMs": 9719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "선형적 통제 선형적 통제 해체를 통한\n입면 모사 모사 선형적 통제라는 거면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7117599,
    "dDurationMs": 11161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이래서 이래서이 쭉 코어런트하게\n일관되게 가는 그거를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7124119,
    "dDurationMs": 10881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "해체해서 인명기 잠들 때 상태\n멍하게이 생각 저 생각하는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7132079,
    "dDurationMs": 6921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 상태랑 굉장히 비슷해져요.\n과의 대입법은요. 완벽하게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7137440,
    "dDurationMs": 7719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "비서사적이고\n비정서적인 중립 자극이에요. 배토벤,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7142360,
    "dDurationMs": 7120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "낭만주의 음악, 뭐 리스트, 뭐\n쇼갈등,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7147199,
    "dDurationMs": 8801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "고조, 절종, 화려함, 급격한\n음량변화 극적 서사와 정서적 동요 막",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7153920,
    "dDurationMs": 5600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 꽝 꽝 끝났을 때 피아노 연주\n꽝 끝났을 때 끝난 거 다 알고 막",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7157840,
    "dDurationMs": 6160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이런 거죠.\n그 근데 이거는 그런 정서적 동요를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7161880,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "유발하기 때문에 편도체 수면 개시\n조절시 시스템 자각에 잠을 깨워요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7165920,
    "dDurationMs": 8920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "별로 수면하는데 도움이 안 된다.\n이거 반면에 바흐의 대입법은 세속적",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7171360,
    "dDurationMs": 10640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "줄거리 그런 거 없어요. 정서 자극\n없어요. 그냥 순수하고 기약적인 음향",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7179360,
    "dDurationMs": 8960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "패턴의 직조물이에요. 해결해야 될\n현실적 문제나 정서적 결정과 연결이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7185639,
    "dDurationMs": 6761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잘 안 돼요. 현실 문제랑 연결이 안\n돼요. 완전 안전한 중립적 주의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7190719,
    "dDurationMs": 8081,
    "wWinId": 1,
    "segs": [ {
      "utf8": "대상이에요.\n둘째, 대입법의 구조 자체가 청자의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7195960,
    "dDurationMs": 10159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "주의력을 5초 내지 10초 간격으로\n성부 간의 자발적으로 전환시켜요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7201400,
    "dDurationMs": 8279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 그 성부 멜로디 그거를 나눠서\n들으라고요. 그러니까 세 가지 다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7207800,
    "dDurationMs": 5439,
    "wWinId": 1,
    "segs": [ {
      "utf8": "들으라는 얘기예요. 세 가지 다\n들으면 어떻게 돼요? 왔다 갔다 하게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7211719,
    "dDurationMs": 6400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "돼요. 한 개만 들으면 계속\n따라가지만 다 들으라고요. 이거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7215320,
    "dDurationMs": 7640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "들었다, 저거 들었다 하는데 바은\n아프가셔 인벤션에 보면 한 성부의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7220320,
    "dDurationMs": 9359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "주제가 제시된 후 실제로 약 5초에서\n12초 간격으로 다른 성부에서 새로운",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7226560,
    "dDurationMs": 8920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "선율적 사건이 진입합니다. 그래서\n사실은 세계가 흘러가는데 응답도 하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7233239,
    "dDurationMs": 8321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "위에서 내려오던게 밑으로 연결이 돼서\n가기도 하고 대주제 뭐 이거 왔다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7237880,
    "dDurationMs": 8839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "갔다 하고 뒤집어지기도 하고 바뀌기도\n하고 이런 새로운 선율 사건이 계속",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7244560,
    "dDurationMs": 8360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "조금씩 생겨요. 그게 5초에서 12초\n간격 굉장히 비슷하죠. 예. 인적",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7249960,
    "dDurationMs": 6520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "셔플 그 요건하고 청자가 성부를\n추적하면서들을 때 주위의 초점을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7254599,
    "dDurationMs": 5801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "소프에서 알토로 알토 테너 테너\n베이스 5조 10조마다 계속 왔다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7258440,
    "dDurationMs": 10759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "갔다 하게 하고이는\n스스로 단어를 생각해내는 수거 없이도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7265239,
    "dDurationMs": 10801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "보드행의 인지적 셔플과 동일한 주기의\n주의 전화를 청각 영역에서 자동으로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7272400,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "구현합니다. 저는 보드의 인지적 셔플\nSDI보다이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7279159,
    "dDurationMs": 9321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "평균열이 음악 듣는게 훨씬 더 인지적\n플이 잘 일어날 거라고 확신을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7284840,
    "dDurationMs": 7359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "합니다. 저는. 왜냐면 단어 막 쥐어\n짜내야 되고 막 그리고 단어 막히면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7290840,
    "dDurationMs": 6040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "스트레스 받고 그랬잖아. 이건 그거\n없잖아요. 이건 그거 없어요. 단어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7295119,
    "dDurationMs": 6921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "짜내는 거 아니에요. 게다가\n인지적으로 뺏어 가는 거 훨씬 더",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7299760,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "커요. 이거 따라가 보세요. 한번.\n딴 생각 들 여지가 없다고요. 계사가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7304880,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "정기적으로 왔다 갔다 해야 되고\n이거고요. 그다음에 가장 결정적인",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7311560,
    "dDurationMs": 5880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "기재가 뭐냐면요. 야, 이게 진짜\n핵심이야. 이게 SDI가 따라오지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7315639,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "못하는 거야. 이게 보두행의 그\nSDI 이거 따라오지 못하는 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7319360,
    "dDurationMs": 9839,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 바하의 평균율이 수면 명상으로\n최고인게이 세 번째 이유예요. 뭐냐면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7327239,
    "dDurationMs": 7761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "삼성까지는\n웬만하면 다 따라가실 거예요. 세 개",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7331159,
    "dDurationMs": 10165,
    "wWinId": 1,
    "segs": [ {
      "utf8": "흘러가는 거는. 근데 4성이 되죠.네\n개. 매우매우 헷갈립니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7338719,
    "dDurationMs": 6201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "4성까지는 그래도\n[콧방귀] 좀 훈련하고 그러면 들으실",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7342719,
    "dDurationMs": 7161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수 있어요.\n그런데 웬만큼 처음 들으시면 2성",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7348119,
    "dDurationMs": 6641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "지나서 3성 되면 벌써 헷갈리기\n시작하다가 4성 되면 어이고 이게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7352639,
    "dDurationMs": 6600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐지? 이게 이게 지금 되는 거\n같기도 하고 두 개 같기도 하고 세",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7357119,
    "dDurationMs": 6040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "개도 이성으로 들리고 4성도 이성으로\n들리고 자꾸 그런 식으로 가요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7360639,
    "dDurationMs": 9761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게네 개가데 이성과는 좀 다른 거\n같고 이게 잘 안 따라가져요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7367920,
    "dDurationMs": 8440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "오성이 되면\n우와 그러면 그냥 아름답고 복잡하다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7373159,
    "dDurationMs": 8241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이렇게 돼 버려요. 다시 말해서\n추적이 불가능해져요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7379199,
    "dDurationMs": 9400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "멍해져요.\n이때 진짜 졸려요. 처음 일성부와",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7384880,
    "dDurationMs": 7680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이성부가 진행될 때는 선연적 분석적\n주의력으로 우리의 의도를 갖고 요게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7390480,
    "dDurationMs": 5920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "일성 어 멜러디 간다. 어 그거\n받아서 2성까지 돼서 이제 두 개가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7394520,
    "dDurationMs": 6760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "동시에 가네. 여기까지 돼요. 근데\n3성 들어오죠. 어 좀 헷갈린다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7398920,
    "dDurationMs": 9520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "4성 들어오죠. 들어왔는지 안\n들어왔는지도 모르고 4성 뭔가 좀",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7403119,
    "dDurationMs": 10681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "복잡해. 5성 거의 불가능해요.\n4성 5성까지 올라가죠. 여러 개의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7411199,
    "dDurationMs": 8440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "독립적인 선율이 동시에 청교하게\n얽혀서 이게 기가 막히게 얽혀서 가는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7416639,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거거든요. 이게 진행되면 한 번에\n하나의 선형적 흐름만을 처리할 수",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7422079,
    "dDurationMs": 9640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있는 의식 작업 기억의 병목 관계가\n돼서 펼쳐져요. 다시 말해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7428800,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하나씩 따라가는 걸 포기하게 되고\n그걸 부드러운 붕괴라고 부를 수",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7433719,
    "dDurationMs": 9801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있어요. 포기하게 되고 그냥 내 귀에\n들리는 걸 다 받아들이게 돼요. 와,",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7440119,
    "dDurationMs": 9361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "좋다. 복잡하게. 그때 입면 되게\n비슷해져요. 이때 산술 계산이나 업무",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7446679,
    "dDurationMs": 6761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "과제와 달리 음악 감상에는 실패에\n대한 위협이나 수행 불안이 없어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7451639,
    "dDurationMs": 6761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거 하다 보면 안 된다고 여러분\n짜증나겠어요? 그건 또 3승 듣고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7456320,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "4승 듣고 집착하지 마세요. 안\n들리면 그냥",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7461079,
    "dDurationMs": 8761,
    "wWinId": 1,
    "segs": [ {
      "utf8": "마음을 열어 놓고 들으면 돼요. 개별\n성부를 끝까지 분별하여 붙잡으려던",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7466320,
    "dDurationMs": 7279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "표청자의 선형적 추적이\n스르륵 무너져요. 사실은 좌절감",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7472079,
    "dDurationMs": 7921,
    "wWinId": 1,
    "segs": [ {
      "utf8": "없이. 왜냐면 바음악 너무\n아름다우니까 너무 완벽하니까 너무",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7476880,
    "dDurationMs": 7759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "우주 같으니까 이게 이게이 세상의\n소리냐? 어 그야말로 천상의 소리냐?",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7482639,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "우주의 소리냐 막이 상태가 되니까\n그럼 어떻게 돼요? 마음이 열리고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7487280,
    "dDurationMs": 7600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "좌절감 없이 무너져요.\n예. 성부 나눠듣는 걸 포기하게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7492679,
    "dDurationMs": 8321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "된다. 나도 모르게 포기하게 돼요.\n그리고 여러 성부가 고명하는 비선형적",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7498679,
    "dDurationMs": 9480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "공간적이 화음의 공간 사실은 화음은\n아니지만 어떤이 사운드의이 멜로디이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7504960,
    "dDurationMs": 8920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "화려한 공간으로 쫙 내 의식이 펼쳐져\n들어가는 걸 느끼게 돼요. 이때",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7511040,
    "dDurationMs": 9280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "느껴지는게 와 이게 데이빗 보이\n얘기하는 내항적 펼쳐집이구나. 내항적",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7517040,
    "dDurationMs": 7840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "펼쳐짐은 의식으로 이런게 안으로\n내쪽으로 내항적 펼쳐짐. [콧방귀]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7523000,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "내면서 소통 6장에 보면이 개념이\n나옵니다. 그 선형적 인과적 정보",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7527760,
    "dDurationMs": 6000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "처리의 사슬이 풀리고 다성부의 선율\n조각들이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7532119,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "여기 좀 들리고 저기 좀 들리고 이런\n식으로 들려요. 비선형적으로 막",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7536159,
    "dDurationMs": 11281,
    "wWinId": 1,
    "segs": [ {
      "utf8": "떠다지는인지 상태는 뇌가 각성해서 난\n아까 얘기했던 1단계 수면 첫 번째",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7543960,
    "dDurationMs": 10199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면으로 도입할 때 경는\n인면기의 비일관적이고도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7550480,
    "dDurationMs": 11079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "파편적인 의식의 흐름과 구조적으로\n완전히 동일합니다. 그러니까 졸립죠.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7559000,
    "dDurationMs": 8239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 결과 뇌 수면 개시 조절 시스템은\n뇌 N네피시에서 목표 지향적 서사",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7564280,
    "dDurationMs": 9279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "처리가 종료되고 이미 인면기가 시작된\n것으로 판독해서 이거 하다 보면 즉각",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7571079,
    "dDurationMs": 6401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면 스위치를 개방하게 되는 거죠.\n다시 말해서이이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7575400,
    "dDurationMs": 7199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "멜로디이 바음악을 딱하게 들게 되면\n대네피질에서이 감시하고 있 이게 지금",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7579480,
    "dDurationMs": 9040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "야 계속 지금 서사 처리하고 있냐\n지금 자도 되는 상황이냐 근데 서사",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7585520,
    "dDurationMs": 8079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "처리가 계속 되던게 갑자기이 4성\n5성 들으면서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7590599,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그야말로 몽롱해지는 거죠\n그러면 아 이미 인명기가 시작됐구나",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7595920,
    "dDurationMs": 7799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "얘네 그리고 수면 스위치 개방해서\n깊이 잠됩니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7601239,
    "dDurationMs": 10681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이래 이래도 안 해 보실래요?\n꼭 해 보셔야겠죠? 이거 하면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7606840,
    "dDurationMs": 11600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "참 잘 주무실 겁니다. 그래서 제가\n어 정말 많이 들어본 거지만",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7614599,
    "dDurationMs": 13161,
    "wWinId": 1,
    "segs": [ {
      "utf8": "낑낑되고이 바하 평균을 한 번도 안\n들어보신 분을 위해서 그냥 처음 듣는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7622040,
    "dDurationMs": 13679,
    "wWinId": 1,
    "segs": [ {
      "utf8": "분을 위해서 뭐냐 골랐어요.\n제일 쉬운 거부터 쉽다는게 뭐냐면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7632199,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "리듬 윤곽이 가장 따다단 딴딴 따다단\n여기 이렇게 가거든요. 따단 따다단",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7637679,
    "dDurationMs": 6841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거 가는 죄송합니다. 잘 따라하지\n못해 아까 우리가 들었던 거 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7642000,
    "dDurationMs": 8559,
    "wWinId": 1,
    "segs": [ {
      "utf8": "847번 B\n요걸로 시작해 보세요. 그러면 이거는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7646960,
    "dDurationMs": 9599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "누가 들어도 1성 2성까지는 쉽게\n들리고 3성도 좀 들리기 시작합니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7653760,
    "dDurationMs": 7240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 요거 듣다가 그다음에 또\n삼성가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7658760,
    "dDurationMs": 6600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래서 아주 원화하고 평화로운 1분\n사비초밖에 안 돼요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7663280,
    "dDurationMs": 7720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그것도 듣다가\n그다음에 느린 삼성부가 아주 느리고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7669040,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 어떻게 보면 제가 보기에이\n많은이 저기 평균율 이것 중에 가장",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7675239,
    "dDurationMs": 7960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "명상적이지 않은가?\n주제가 좀 뒤집히기도 하고 겹쳐지기도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7679360,
    "dDurationMs": 9799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하고 후반부에는 음의 길이가 길게\n길게 가면서 완벽한 데이법 진짜",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7687320,
    "dDurationMs": 6799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아름답죠.\n졸려요. 여기까지 오면 분명히 졸릴",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7691040,
    "dDurationMs": 9360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "거라고 생각해요. 그 얼마야? 한\n3분 7 8분이면 여러분 몽롱해지기",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7697239,
    "dDurationMs": 7721,
    "wWinId": 1,
    "segs": [ {
      "utf8": "시작할 겁니다. 그 3선까지는 웬만큼\n들리실 거예요.이 여기는 1번 2번",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7703000,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3번 다이\n한 선율로 시작해서 2성이 겹쳐지고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7708040,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "3성이 겹쳐지는 그런 형식이에요.\n그러니까 다 들릴 거예요. [콧방귀]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7712480,
    "dDurationMs": 9280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그리고\n사성가가 4분짜리가 있습니다. 이것도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7718159,
    "dDurationMs": 10361,
    "wWinId": 1,
    "segs": [ {
      "utf8": "평화롭고 고전적인데이 사성은\n나눠듣기 어려울 거예요. 더욱",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7725040,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "몽롱해지실 겁니다. 인지적 셔플링\n확실히 생길 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7730840,
    "dDurationMs": 9960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "오성 부관은\n이거 이제 포기하는 따라하는 건 포기",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7737719,
    "dDurationMs": 7121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 5개 성분은 사실은 청각 기업.\n왜냐하면 이게 청각의 메모리 기억으로",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7743280,
    "dDurationMs": 5640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하는 거예요. 작업 기업. 워킹\n메모리. 왜냐면 이게 한 메모리",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7747400,
    "dDurationMs": 5880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "멜로디 들어가는 걸 기억하고 있어야\n두 번째 메모리가 하는데 1번 2번을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7751000,
    "dDurationMs": 7320,
    "wWinId": 1,
    "segs": [ {
      "utf8": "기억한 상태에서 3번을 들어야 이게\n같이 간다는게 느껴진단 말이에요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7755599,
    "dDurationMs": 7881,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그걸 세 개까지 해도 할까 말까 한데\n다섯 개를 어떻게 하겠어요? 인간의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7760639,
    "dDurationMs": 8121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "청각 작업 기억으로 개벌 분리하는게\n사실과 사실상 불가능하지 않을까? 전",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7765920,
    "dDurationMs": 6600,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그렇게 생각합니다. 물론 막 오송도\n난 들어 육성도 들어 이렇게 난",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7771000,
    "dDurationMs": 5960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "구별해서 오송도 듣고 육성도 들\n이렇게 주장하시는 분을 전 보기는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7774679,
    "dDurationMs": 7121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "봤어요. 근데 저는 반신반이 합니다.\n왜냐면 저는 죽었다놔도 못 하겠으니까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7779760,
    "dDurationMs": 7720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "오성을 뚜렷하게 나눠들어 저는 못\n합니다. 근데 삼성과 오성이 뭔가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7785360,
    "dDurationMs": 7359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "분위기는 다르다. 그 정도가\n아마추어인 제가 듣는 정도입니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7791000,
    "dDurationMs": 6079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그럼 어떻게 되냐면이 오성 다섯\n번째들을 때는 성부를 구별하는 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7795000,
    "dDurationMs": 7159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "멜로디 따라가는 거 일체 의도 다\n내려놓고요. 열린 주의로 다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7800480,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "받아들이세요.\n음악으로 들어가세요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7804199,
    "dDurationMs": 12880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "음악이 여러분을 둥둥 띄워 줄\n겁니다. 음악에 내 삶을 맡기고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7811440,
    "dDurationMs": 12360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "음악에 내 온 몸과 마음을 툭\n맡기면 오늘 밤 잘 주무실 겁니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7821840,
    "dDurationMs": 9920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "예.\n이게 그",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7826760,
    "dDurationMs": 11160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠깐만요. 그래서 이게 한 가지\n요거를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7833320,
    "dDurationMs": 11040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "또 여기까지 얘기했으니까 제가 사실은\n아 그러면은 요것도 그것도 있어요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7841119,
    "dDurationMs": 3241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐가 있냐면이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7844920,
    "dDurationMs": 6920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "바 평균율\n연주는 정말 많은 피아니스트들이 다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7850040,
    "dDurationMs": 8079,
    "wWinId": 1,
    "segs": [ {
      "utf8": "했습니다.\n그래서이 유튜브 이런데 아니면 어떤",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7854360,
    "dDurationMs": 9680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "다른 그 뭐 스포티파이나 뭐 찾아보면\n굉장히 많이 그 저기가 나올 거예요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7860480,
    "dDurationMs": 9960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "연주가. 그러면 누구 걸 들어야 돼?\n이런 그 궁금한게 예 생기실 수",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7867760,
    "dDurationMs": 7359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있죠. 누구 연주를 드? 그 계는\n완전히 여러분 뭐 누구 거 연주를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7872840,
    "dDurationMs": 8480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "듣든 그거 뭐 이게 다 비슷하죠.\n근데 완전히 이제 개인 취향 예.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7878559,
    "dDurationMs": 8321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "개인 취향으로 그냥 추천을 드립니다.\n제가 좋으니까 뭐 저처럼 이거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7883159,
    "dDurationMs": 10641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "좋아하시는 분도 많겠죠. 제가 진짜\n좋아하는 피아니스트가 뭐 몇 명",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7890719,
    "dDurationMs": 9000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있지만 특히 좋아하는 분이 스피아토\n슬라프 리터. 이분 진짜 제가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7896400,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "좋아하게 된 이유는 어 리스트 피아노\n쏘나타.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7901559,
    "dDurationMs": 8560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아 리스트 피아노 협주공. 예.\n이분의 리스트 피아노 협주공. 예.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7907239,
    "dDurationMs": 8641,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그리고 마르타 아르리치의 리스트\n피아노 소나타 이런 것 때문에 이제",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7912400,
    "dDurationMs": 8719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "막 좋아했는데이 루히터 이분이\n평균율을 기가 막히게 연주했습니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7918040,
    "dDurationMs": 6360,
    "wWinId": 1,
    "segs": [ {
      "utf8": "진짜 아 저는이 연주가 제\n개인적으로는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7922800,
    "dDurationMs": 9480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "최고의에\n수면 유도 명상음이다 이렇게 생각을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7928440,
    "dDurationMs": 9199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "합니다. 진짜 잘 졸 졸름 잘 와요.\n예 목적이 그겁니다. 음악 듣고 말게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7934719,
    "dDurationMs": 8681,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아니라 잠 깊은 이완과 명상 수면\n유도 명상 이거 하는데 그러면 리시터",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7940960,
    "dDurationMs": 5560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "스터트 스라프 리시터에\n리터에 뭐 칼 리시터도 있고 딴",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7944960,
    "dDurationMs": 5960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "리시터도 좀 있어요. 그이\n리시터에이이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7948639,
    "dDurationMs": 9241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "제가 말씀드린 이거를 평균율을 들어\n보시면 좋은데 한 가지이 좀 옛날",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7953760,
    "dDurationMs": 7359,
    "wWinId": 1,
    "segs": [ {
      "utf8": "녹음 이에요. 리메스터도 좀 한한 거\n같은데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7959440,
    "dDurationMs": 9159,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이거만큼\n좋은게 좀 나중에 녹음하고 한게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7963639,
    "dDurationMs": 10321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "뭐냐면 안드라스 슈프의 또 평균율게\n있습니다. 아, 이것도 아주 깔끔하고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7972400,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "깨끗하고\n정말 자극 없이 각 멜로디를 추적하며",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7977280,
    "dDurationMs": 8959,
    "wWinId": 1,
    "segs": [ {
      "utf8": "잠들기에 참죠.\n그다음에 또 제가 그 좋아하는 피안스",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7983480,
    "dDurationMs": 7239,
    "wWinId": 1,
    "segs": [ {
      "utf8": "글랜 굴드라고 있는데 글랜 굴드의\n평균율은 적어도이 목적으로는 추천하지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7989400,
    "dDurationMs": 9880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "않습니다. [목을 가다듬음]\n어 글랜골드는 진짜 뭐 뭐 많이 느려",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 7997079,
    "dDurationMs": 8801,
    "wWinId": 1,
    "segs": [ {
      "utf8": "느리게 쳤다 빠르게 쳤다 뭐 자기\n마음대로 하고 더 황당한 건 간헐적",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8003440,
    "dDurationMs": 8520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "허밍 어머 이거 있잖아요. 어떤 땐\n심해요. 예, 정말 너무한다 싶을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8008400,
    "dDurationMs": 7920,
    "wWinId": 1,
    "segs": [ {
      "utf8": "정도로 떠들면서\n한단 말이에요. 그 뭐 라이브에서는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8014040,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그래도 되지만이 뭐지?이 스튜디오에서\n녹음하는데 그때도 흥을 가지고 굉장히",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8019840,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "좀 거슬릴 수가 있어요.이 저기\n뭐야? 하지만 연주는 압도적이죠. 좀",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8024760,
    "dDurationMs": 8000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "다른 의미에서. 그래서 수면 자려고\n듣는게 아니라 그냥 평균율을 내가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8030239,
    "dDurationMs": 9201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "감상하려고 듣겠다 그러면 글랭골드 곡\n강추입니다. 근데 수면용으로 듣겠다",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8036159,
    "dDurationMs": 7080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러면 리터나 안더라스프의 곡을\n추전합니다. 아, 귀학 말이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8040880,
    "dDurationMs": 7880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "나왔으니까 글랜골드에에\n또 좋아하시면 저거를 들어 보시면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8045840,
    "dDurationMs": 8440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "저의 페이버릿은 그\n베토벤 소나타에",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8052000,
    "dDurationMs": 8880,
    "wWinId": 1,
    "segs": [ {
      "utf8": "작품 번호 31\n거기 진짜 그게 16 쏘나타 16번",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8057559,
    "dDurationMs": 7520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "17번 이렇게 되는 것들이죠. 아,\n그거 글랭굴드가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8063360,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그\n16번 쏘나타 배트맨 쏘나타 16번",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8067760,
    "dDurationMs": 8240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그것도 한번 들어 보세요. 그거는\n이런 그 수면 이거 아니에요. 그건",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8073880,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아침에 일어나서에\n차한잔하시면서 들기 참 좋은 거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8079199,
    "dDurationMs": 8201,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어입니다.\n자, 그러면",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8084440,
    "dDurationMs": 7400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 이제 오늘 강의를 이제 마치려고\n하는데 이게 하다 보니까 지난주에도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8089280,
    "dDurationMs": 8680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "좀 말씀을 드렸는데\n그래서 제가 이런 그이 바하 음악을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8095320,
    "dDurationMs": 7480,
    "wWinId": 1,
    "segs": [ {
      "utf8": "설명을 하면서이 하면 좋겠다 이런\n생각을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8099880,
    "dDurationMs": 6640,
    "wWinId": 1,
    "segs": [ {
      "utf8": "갖고 있다가 그래서 지난 시간에\n말씀드렸던이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8104440,
    "dDurationMs": 8799,
    "wWinId": 1,
    "segs": [ {
      "utf8": "명상 이거 있잖아요. 예. 그래서이\n좀 또 깨알 홍보를 좀 하려고 하는데",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8109679,
    "dDurationMs": 9960,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이게 브랜드 님하고 섹스폰하고 해서\n이쪽 그 크레디아라는 우리나라에서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8116280,
    "dDurationMs": 11080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "제일 큰 그 어 공연 기획사랑 같이\n이런 음악을 하게 됐는데이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8124159,
    "dDurationMs": 7841,
    "wWinId": 1,
    "segs": [ {
      "utf8": "조윤성 이분이 명상적인 피아노 연주도\n많이 하는데 또 평균율도 연구이 연주",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8130400,
    "dDurationMs": 7080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "많이 하시는 분입니다. 그래서\n이분한테 아까 말씀드렸던 거",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8134840,
    "dDurationMs": 8719,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있잖아요. 그 평균 1성, 2성,\n3성 따라가는 걸 관객과 같이 한번",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8140800,
    "dDurationMs": 8399,
    "wWinId": 1,
    "segs": [ {
      "utf8": "해 보자. 아 그렇게 지금 해서\n12월 23일 공연에 이걸 해 볼",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8145719,
    "dDurationMs": 8440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "겁니다. 그러니까 어 일성 가고 여기\n이성 가죠 뭐 가고 그 중간에 잠깐",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8151880,
    "dDurationMs": 7040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "스톱하고 다시 들어와서 들리세요 뭐\n하고 이거 이러고 저거이 얘기를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8156599,
    "dDurationMs": 9080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그니까 오늘처럼 길게 못 하죠. 이건\n컨서트니까 짧게 짧게 설명은 할 수",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8161400,
    "dDurationMs": 10279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "있는데 그래서 어 이거를 현장에서이\n연주하면서 오늘 강의했던 거를 어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8168760,
    "dDurationMs": 9680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "한번 같이 체험해 보는 어 그 컨서트\n롯데 컨서트에서 해 보려고 하고요.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8174320,
    "dDurationMs": 10560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그다음에 또 432Hz로 조율된 그\n피아노로 또 명상적 음악도 듣고 어",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8181840,
    "dDurationMs": 8520,
    "wWinId": 1,
    "segs": [ {
      "utf8": "브랜든의에 섹스폰 연주도 있고\n그다음에 그 롯데 콘서트에 얼엄",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8187599,
    "dDurationMs": 7760,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어마어마한 그 큰 바이퍼오르간이\n있거든요. 그래서 그 바이퍼오르간",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8192519,
    "dDurationMs": 9401,
    "wWinId": 1,
    "segs": [ {
      "utf8": "바이오르간과 또 섹스폰의 같은 연주\n이런 거를 쭉 하는 그런 콘서트를",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8198519,
    "dDurationMs": 9200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "12월 23일에에 해 보려고 예\n합니다. 그래서 거기 오시면은 아이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8204760,
    "dDurationMs": 8040,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수면 유도 명상 이런 것도 조금 같이\n하고 좀 일반적인 그러니까 주로 음악",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8210679,
    "dDurationMs": 8241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "음악을 많이 하지만 일반적인\n음악회라는 상당히 다른 그런",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8216080,
    "dDurationMs": 8599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "크리스마스 전전날 연말에 한번 해\n보실 수 있는 기회가 됩니다. 물론",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8222160,
    "dDurationMs": 7519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그 그런 연주에 와야만 할 수 있는게\n아니고 오늘이 강의로요. 여러분",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8227519,
    "dDurationMs": 6241,
    "wWinId": 1,
    "segs": [ {
      "utf8": "얼마든지 지금 하실 수 있습니다.\n제가",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8231319,
    "dDurationMs": 8400,
    "wWinId": 1,
    "segs": [ {
      "utf8": "다 드렸잖아요.이\n저의 아끼는이 곡 리스트이 비장의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8237280,
    "dDurationMs": 6560,
    "wWinId": 1,
    "segs": [ {
      "utf8": "무기인데이 이거 [웃음]\n저는 엄청난 이게 저기 지적",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8241920,
    "dDurationMs": 7759,
    "wWinId": 1,
    "segs": [ {
      "utf8": "재산권이라고 생각합니다. 이거 이거\n이거 왜냐면 이거 이거 이렇게",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8246080,
    "dDurationMs": 9599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "구성하기 쉽지 않아요. 이게 이게 다\n듣고 다 이론에 맞춰서 이게 다 점점",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8252240,
    "dDurationMs": 8199,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어려운 쪽으로 이렇게 한 거고 어\n누구의 연주가 좋은가? 요건 이론",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8257639,
    "dDurationMs": 8840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "아니고 저의 순수한 개 개인적\n취향으로요",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8262359,
    "dDurationMs": 9080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "추천해 드린 겁니다. 자, 그래서\n아, 오늘 이제 강의는 어 여기서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8269960,
    "dDurationMs": 6080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "줄이도록\n하겠습니다.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8273080,
    "dDurationMs": 8319,
    "wWinId": 1,
    "segs": [ {
      "utf8": "정말 많은 분들이\n수면 때문에 어려움을 겪고 그래서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8277960,
    "dDurationMs": 6639,
    "wWinId": 1,
    "segs": [ {
      "utf8": "가장 많은 댓글이 수면에 대한 거고\n그래서 그렇게 어려움을 많이 겪고",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8282639,
    "dDurationMs": 6680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "계시고 또는 저는 수면에 대해서\n강조를 많이 했기 때문에 제가 오늘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8286800,
    "dDurationMs": 8280,
    "wWinId": 1,
    "segs": [ {
      "utf8": "강의를 이렇게 준비하게 된 거는\n수면의 중요성을 제가 너무 강조한 것",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8292040,
    "dDurationMs": 10000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "때문에 오히려 그런 여러 가지 자료는\n노력 그런 행동들을 도움이 안 되는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8298800,
    "dDurationMs": 9080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그런 행동들을 하셔서 더 불면증으로\n가시는 일이 이 생길까 봐 그러지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8304280,
    "dDurationMs": 9840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "않게 하하려고 오늘 강의를 어\n준비했고요. 그다음에 비장의 무기",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8310559,
    "dDurationMs": 9160,
    "wWinId": 1,
    "segs": [ {
      "utf8": "평균율을 틀어 놓고 어 주무시는\n그거를 한번 해 보시라고에 제가 오늘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8316840,
    "dDurationMs": 11200,
    "wWinId": 1,
    "segs": [ {
      "utf8": "자세하게 안내드렸습니다.\n여기 만약 해 보시고 효과 있으면이",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8322719,
    "dDurationMs": 9680,
    "wWinId": 1,
    "segs": [ {
      "utf8": "영상에 댓글 남겨 주시면 제가 참고\n하도록 하겠습니다. 이게 저한테만 잘",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8330920,
    "dDurationMs": 7240,
    "wWinId": 1,
    "segs": [ {
      "utf8": "되는 건지 아직 실험 연구를 안 해\n봐서 어 다른 분들에게도 도움이 되는",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8335280,
    "dDurationMs": 9279,
    "wWinId": 1,
    "segs": [ {
      "utf8": "건지 아마 이론적으로 이렇게 좀 어\n확고하니까 어 도움이 되지 않을까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8340559,
    "dDurationMs": 10321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "싶습니다. 아 그리고 요런 그요 음악\n자체를 제가 그 명상 앱에 이제 명상",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8348479,
    "dDurationMs": 8321,
    "wWinId": 1,
    "segs": [ {
      "utf8": "앱도 다음 주 토요일에 나올 텐데\n아직 오픈이 안 됐죠. 지금 이제 곧",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8353200,
    "dDurationMs": 11246,
    "wWinId": 1,
    "segs": [ {
      "utf8": "16분이 될 텐데 그런 그 명상 앱는\n어 제가 만든 이런 데이법 음악",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8362599,
    "dDurationMs": 6840,
    "wWinId": 1,
    "segs": [ {
      "utf8": "이것도 넣으려고 생각 중입니다.\n[음악]",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8365599,
    "dDurationMs": 10080,
    "wWinId": 1,
    "segs": [ {
      "utf8": "왜냐면 제가 만든 앱의 그 기존의\n음악을 넣을 수는 없으니까",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8372200,
    "dDurationMs": 10479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "대입법 음악 바을 흉내내서 최대한\n만든 이런 데법 음악을 어 거기다 몇",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8379439,
    "dDurationMs": 7521,
    "wWinId": 1,
    "segs": [ {
      "utf8": "개 또 어 넣으려고 생각 중입니다.\n근데 아직 좀 더 준비를 저도",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8384280,
    "dDurationMs": 7440,
    "wWinId": 1,
    "segs": [ {
      "utf8": "연구하고 준비를 해야 돼서 어 가장\n첫 버전의 앱에는 아마 못 나오지",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8389399,
    "dDurationMs": 8121,
    "wWinId": 1,
    "segs": [ {
      "utf8": "않을까 [음악] 조금 더 준비를 해서\n근데이 앱은 계속 그 업데이트해서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8394720,
    "dDurationMs": 7061,
    "wWinId": 1,
    "segs": [ {
      "utf8": "어 나올 거니까요. 그 인지엄 앱 그\n앱에 대한 소개는 실제로 다운 받을",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8399800,
    "dDurationMs": 7720,
    "wWinId": 1,
    "segs": [ {
      "utf8": "수 있게 됐을 때 실제로 오픈됐을\n[음악] 때 다음 주에 말씀드리도록",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8405200,
    "dDurationMs": 7000,
    "wWinId": 1,
    "segs": [ {
      "utf8": "하겠습니다.\n예.",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8408920,
    "dDurationMs": 8120,
    "wWinId": 1,
    "segs": [ {
      "utf8": "그러면 오늘\n바하의",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8413840,
    "dDurationMs": 9519,
    "wWinId": 1,
    "segs": [ {
      "utf8": "평균율 후가\n그 대입법 선율을 따라가시면서",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8421720,
    "dDurationMs": 9599,
    "wWinId": 1,
    "segs": [ {
      "utf8": "편안하게\n푹 주무시기 바랍니다. 저는 다음",
      "acAsrConf": 0
    } ]
  }, {
    "tStartMs": 8426840,
    "dDurationMs": 4479,
    "wWinId": 1,
    "segs": [ {
      "utf8": "주에 또 뵙겠습니다. 감사합니다.",
      "acAsrConf": 0
    } ]
  } ]
}
